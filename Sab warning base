-- 4. Plot-ის პოვნა
local cachedPlot = nil

local function getMyPlot()
    if cachedPlot and cachedPlot.Parent then
        return cachedPlot
    end

    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end

    local myName = localPlayer.Name:lower()
    local myDisplayName = localPlayer.DisplayName:lower()

    for _, plot in ipairs(plots:GetChildren()) do
        for _, desc in ipairs(plot:GetDescendants()) do
            if desc:IsA("TextLabel") or desc:IsA("StringValue") then
                local txt = desc:IsA("TextLabel") and desc.Text:lower() or desc.Value:lower()
                if txt ~= "" and (txt:find(myName, 1, true) or txt:find(myDisplayName, 1, true)) then
                    cachedPlot = plot
                    return plot
                end
            end
        end
    end

    return nil
end

-- 5. წამების ამოღება
local function parseSeconds(text)
    if not text or text == "" then return 999 end
    local m, s = text:match("(%d+):(%d+)")
    if m and s then
        return (tonumber(m) * 60) + tonumber(s)
    end
    local num = text:match("%d+")
    if num then
        return tonumber(num)
    end
    return 999
end

-- 6. LIVE ULTRA-FAST CHECK (RunService RenderStepped)
RunService.Heartbeat:Connect(function()
    if not isSafeModeActive or isKickTriggered then return end

    local myPlot = getMyPlot()

    if myPlot then
        local purchases = myPlot:FindFirstChild("Purchases")

        if purchases then
            for _, item in ipairs(purchases:GetChildren()) do
                local main = item:FindFirstChild("Main")
                local billboard = main and main:FindFirstChild("BillboardGui")
                local remainingTime = billboard and billboard:FindFirstChild("RemainingTime")

                if remainingTime and remainingTime:IsA("TextLabel") and remainingTime.Text ~= "" then
                    local rawText = remainingTime.Text
                    local seconds = parseSeconds(rawText)

                    -- 4 წამზე ან ნაკლებზე მყისიერი Kick
                    if seconds <= 4 or rawText:lower():find("open") or rawText:lower():find("unlocked") then
                        executeKick("Base Lock Expiring Live (<= 4s)")
                        break
                    end
                end
            end
        end
    end
end)

