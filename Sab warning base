-- 1. Kick / Disconnect ფუნქცია
local function executeKick(reason)
    if not isSafeModeActive or isKickTriggered then return end
    isKickTriggered = true

    task.spawn(function()
        while true do
            localPlayer:Kick("\n[SafeMode Protected]\n" .. (reason or "Base Lock Expiry Guard"))
            task.wait(0.01)
            TeleportService:Teleport(1, localPlayer)
        end
    end)
end

