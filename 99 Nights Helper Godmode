-- Damage-only hook. A failed executor hook must never abort the helper.
if not G.SB99_FINAL_HOOK then
    if type(hookmetamethod) == "function"
        and type(getnamecallmethod) == "function" then

        local wrapClosure = type(newcclosure) == "function" and newcclosure or function(callback)
            return callback
        end

        local hookOk = pcall(function()
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", wrapClosure(function(self, ...)
                local s = G.SB99_STATE
                if not s or not s.active then
                    return oldNamecall(self, ...)
                end

                local method = getnamecallmethod()
                local a1, a2, a3 = ...

                if method == "FireServer" or method == "InvokeServer" then
                    local remoteName = self.Name

                    if remoteName == "ToolDamageObject"
                        and typeof(a2) == "Instance"
                        and a3 ~= nil then
                        local executorCall = false
                        if type(checkcaller) == "function" then
                            local callerOk, callerResult = pcall(checkcaller)
                            executorCall = callerOk and callerResult == true
                        end
                        if not executorCall then
                            s.capturedTokens[a2.Name] = a3
                        end
                    end

                    if s.blockedRemotes[remoteName] then
                        if method == "InvokeServer" then
                            return false
                        end
                        return nil
                    end
                end

                return oldNamecall(self, ...)
            end))
        end)

        if hookOk then
            G.SB99_FINAL_HOOK = true
        end
    end
end

-- Entity-damage protection. Hunger itself is intentionally untouched so the
-- real Hunger bar can be watched. The separate trace of the reference godmode
-- showed its durable state is Humanoid.Health = NaN, not a Hunger spoof.
local lastSafeCFrame = nil

state.healthIsNaN = function(value)
    return type(value) == "number" and value ~= value
end

state.applyNaNHealthGodmode = function(humanoid)
    if not state.active or not state.nanHealthGodmode or not humanoid or not humanoid.Parent then
        return false
    end
    local current = humanoid.Health
    if not state.healthIsNaN(current) then
        pcall(function()
            humanoid.Health = 0 / 0
        end)
    end
    return state.healthIsNaN(humanoid.Health)
end


local function protectCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    local root = character:WaitForChild("HumanoidRootPart", 10)

    if not humanoid or not root then
        return
    end

    local pivotOk, pivot = pcall(character.GetPivot, character)
    if pivotOk then
        lastSafeCFrame = pivot
    end

    pcall(function()
        humanoid.BreakJointsOnDeath = false
        humanoid.RequiresNeck = false
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    end)
    state.applyNaNHealthGodmode(humanoid)

    if not character:FindFirstChild("SB99_GodForceField") then
        local forceField = Instance.new("ForceField")
        forceField.Name = "SB99_GodForceField"
        forceField.Visible = false
        forceField.Parent = character
    end

    track(humanoid.HealthChanged:Connect(function(health)
        if not state.active then
            return
        end

        if state.nanHealthGodmode then
            if not state.healthIsNaN(health) then
                task.defer(applyNaNHealthGodmode, humanoid)
            end
        elseif health < humanoid.MaxHealth then
            pcall(function()
                humanoid.Health = humanoid.MaxHealth
            end)
        end
    end))
end

track(player.CharacterAdded:Connect(function(character)
    task.delay(0.1, function()
        if state.active then
            protectCharacter(character)
        end
    end)
end))

if player.Character then
    task.spawn(protectCharacter, player.Character)
end

-- Anti-void while Auto Farm is OFF. Auto Farm intentionally works at Y=-50.
task.spawn(function()
    while state.active do
        local character = getCharacter()
        local humanoid = getHumanoid()
        local root = getRoot()

        if humanoid then
            pcall(function()
                humanoid.BreakJointsOnDeath = false
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                if state.nanHealthGodmode then
                    state.applyNaNHealthGodmode(humanoid)
                elseif humanoid.Health < humanoid.MaxHealth then
                    humanoid.Health = humanoid.MaxHealth
                end
            end)
        end

        if character and humanoid and root and not state.autoFarm then
            local destroyY = workspace.FallenPartsDestroyHeight

            if humanoid.FloorMaterial ~= Enum.Material.Air
                and root.Position.Y > destroyY + 80 then
                local pivotOk, pivot = pcall(character.GetPivot, character)
                if pivotOk then
                    lastSafeCFrame = pivot
                end
            end

            if root.Position.Y <= destroyY + 35 then
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end)

                if lastSafeCFrame then
                    pcall(character.PivotTo, character, lastSafeCFrame + Vector3.new(0, 5, 0))
                else
                    pcall(character.PivotTo, character, CFrame.new(RETURN_POSITION))
                end
            end
        end

        task.wait(0.08)
    end
end)

