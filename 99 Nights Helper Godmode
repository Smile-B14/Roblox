    end

    return success and (
        response == true
        or (type(response) == "table" and response.Success == true)
    )
end

local gearCooldown = setmetatable({}, { __mode = "k" })

local function grabUpgrade(item)
    if not item or not item.Parent then
        return
    end

    local now = os.clock()
    if gearCooldown[item] and gearCooldown[item] > now then
