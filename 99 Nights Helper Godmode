track(ball.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        ballInput = input
    end
end))

track(UserInputService.InputChanged:Connect(function(input)
    if not ballDragging or input ~= ballInput or not ballInputStart or not ballPositionStart then
        return
    end

    local delta = input.Position - ballInputStart

    if delta.Magnitude > 6 then
        ballMoved = true
    end

    ball.Position = UDim2.new(
        ballPositionStart.X.Scale,
        ballPositionStart.X.Offset + delta.X,
        ballPositionStart.Y.Scale,
        ballPositionStart.Y.Offset + delta.Y
    )
end))

