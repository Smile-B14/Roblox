local function firePromptNow(prompt)
    if not prompt or not prompt.Parent then
        return false
    end
    setPromptInstant(prompt)

    local firePrompt = rawget(G, "fireproximityprompt")
    if type(firePrompt) ~= "function" and type(fireproximityprompt) == "function" then
        firePrompt = fireproximityprompt
    end
    if type(firePrompt) == "function" then
        local ok = pcall(firePrompt, prompt)
        if ok then
            return true
        end
        ok = pcall(firePrompt, prompt, 0)
        if ok then
            return true
        end
    end

    local began = pcall(prompt.InputHoldBegin, prompt)
    if began then
        task.wait()
        pcall(prompt.InputHoldEnd, prompt)
        return true
    end
    return false
end

local function isChestPrompt(prompt)
    if not prompt or not prompt.Parent then
        return false
    end

    local ok, text = pcall(function()
        return string.lower((prompt.ActionText or "") .. " " .. (prompt.ObjectText or ""))
    end)
    if ok and (
        string.find(text, "chest", 1, true)
        or string.find(text, "crate", 1, true)
        or string.find(text, "loot", 1, true)
    ) then
        return true
    end

    local ancestor = prompt.Parent
    for _ = 1, 6 do
        if not ancestor then
            break
        end
        local name = string.lower(ancestor.Name)
        if string.find(name, "chest", 1, true)
            or string.find(name, "loot crate", 1, true) then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

local function getPromptPart(prompt)
    local parent = prompt and prompt.Parent
    if not parent then
        return nil
    end
    if parent:IsA("Attachment") then
        parent = parent.Parent
    end
    return getPart(parent)
end

local function openNearbyChests()
    if not state.autoFarm then
        return
    end

    local root = getRoot()
    if not root then
        return
    end

    local now = os.clock()
    local fired = 0
    for prompt in pairs(promptSet) do
        if prompt.Parent and isChestPrompt(prompt) then
            local part = getPromptPart(prompt)
            if part then
                local dx = part.Position.X - root.Position.X
                local dz = part.Position.Z - root.Position.Z
                local horizontalDistance = math.sqrt(dx * dx + dz * dz)
                if horizontalDistance <= state.promptRange
                    and (not promptCooldown[prompt] or promptCooldown[prompt] <= now) then
                    promptCooldown[prompt] = now + 4
                    if firePromptNow(prompt) then
                        fired = fired + 1
                    end
                end
            end
        end

        if fired >= 8 then
            break
        end
    end
end

local function getLostChildren()
    local characters = workspace:FindFirstChild("Characters")
    local children = {}
    if not characters then
        return children
    end

    for _, child in ipairs(characters:GetChildren()) do
        if child:IsA("Model") and isLostChild(child) then
            state.childRescueObserved[child.Name] = true
            table.insert(children, child)
        end
    end

    table.sort(children, function(a, b)
        return a.Name < b.Name
    end)
    return children
end

local function childIsAtCamp(child)
    if not child or not child.Parent then
        return false
    end

    local lost = child:GetAttribute("Lost")
    if lost == false or lost == 0 or lost == "false" then
        return true
    end

    for _, name in ipairs({ "Rescued", "Saved", "AtCamp", "IsRescued" }) do
        local value = child:GetAttribute(name)
        if value == true or value == 1 or value == "true" then
            return true
        end
    end

    local part = getPart(child)
    if not part then
        return false
    end
    local firePart = getPart(getMainFire())
    local center = firePart and firePart.Position or CAMPFIRE_DROP
    return (part.Position - center).Magnitude <= 120
end

local function getUnrescuedChildren()
    local children = {}
    for _, child in ipairs(getLostChildren()) do
        if childIsAtCamp(child) then
            state.childRescueVerified[child.Name] = true
        else
            table.insert(children, child)
        end
    end
    return children
end

local function verifiedChildCount()
    local count = 0
    for name in pairs(LOST_CHILD_NAMES) do
        if state.childRescueVerified[name] == true then
            count = count + 1
        end
    end
    return count
end

local function getItemBag()
    return player:FindFirstChild("ItemBag")
end

local function getSackStoredCount(sack)
    if not sack then
        return 0
    end

    local count = tonumber(sack:GetAttribute("NumberItems"))
    if count ~= nil then
        return math.max(0, count)
    end

    local itemBag = getItemBag()
    if itemBag then
        for _, item in ipairs(itemBag:GetChildren()) do
            if isLostChild(item) then
                state.childRescueObserved[item.Name] = true
            end
        end
        return #itemBag:GetChildren()
    end
    return #sack:GetChildren()
end

local function chooseRescueSack(requiredSlots)
    local best = nil
    local bestFits = false
    local bestCount = math.huge
    local bestFree = -1

    for _, container in ipairs(ownedContainers()) do
        for _, item in ipairs(container:GetChildren()) do
            if isSack(item) then
                local count = getSackStoredCount(item)
                local capacity = tonumber(item:GetAttribute("Capacity")) or 0
                local free = math.max(0, capacity - count)
                local fits = free >= requiredSlots

                if (fits and not bestFits)
                    or (fits == bestFits and fits and (count < bestCount or (count == bestCount and free > bestFree)))
                    or (not fits and not bestFits and free > bestFree) then
                    best = item
                    bestFits = fits
                    bestCount = count
                    bestFree = free
                end
            end
        end
    end

    return best, bestFree
end

local function equipOwnedItem(item)
    if not item or not item.Parent then
