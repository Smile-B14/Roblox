state.fastFoodTransport = function(item, destination)
    if not item or not item.Parent then return false end
    if not isLive(StartDragging) or not isLive(StopDragging) then refreshRemotes() end
    if not isLive(StartDragging) or not isLive(StopDragging) then return false end
    if not acquireDragLock(0.45) then return false end

    local ok = pcall(function()
        if StartDragging:IsA("RemoteEvent") then
            StartDragging:FireServer(item)
        else
            callUtilityRemote(StartDragging, 0.4, item)
        end
        task.wait(0.025)
        if not item.Parent then return end
        if item:IsA("Model") then
            item:PivotTo(destination)
        elseif item:IsA("BasePart") then
            item.CFrame = destination
        end
        task.wait(0.035)
        if item.Parent then
            if StopDragging:IsA("RemoteEvent") then
                StopDragging:FireServer(item)
            else
                callUtilityRemote(StopDragging, 0.4, item)
            end
        end
    end)
    dragBusy = false
    return ok
end

local function runFoodService()
    if not state.autoFarm or state.foodServiceRunning or state.strongholdControl then
        return
    end
    if isNight() then
        if (getRealHunger() or state.maxHunger) <= state.eatThreshold then
            attemptAutoEat()
        end
        state.lastFoodService = os.clock()
        return
    end

    state.foodServiceRunning = true
    state.emergencyFoodRun = false

    local serviceOk = pcall(function()
        local items = workspace:FindFirstChild("Items")
        if not items then return end

        local foods = {}
        for _, item in ipairs(items:GetChildren()) do
            if isFoodItem(item) then
                table.insert(foods, item)
            end
        end
        table.sort(foods, function(a, b)
            local ac = isCooked(a) and 1 or 0
            local bc = isCooked(b) and 1 or 0
            if ac ~= bc then return ac > bc end
            return (tonumber(a:GetAttribute("RestoreHunger")) or 0) > (tonumber(b:GetAttribute("RestoreHunger")) or 0)
        end)

        local limit = math.min(#foods, tonumber(state.foodBatchLimit) or 64)
        for index = 1, limit do
            if not state.autoFarm or state.strongholdControl or isNight() then break end
            local item = foods[index]
            if item and item.Parent then
                local column = (index - 1) % 8
                local row = math.floor((index - 1) / 8) % 6
                local offset = Vector3.new((column - 3.5) * 1.25, 0, (row - 2.5) * 1.25)
                local destination = CFrame.new(FOOD_AREA + offset)
                if not state.fastFoodTransport(item, destination) then
                    dragItemTo(item, destination)
                end
                if item.Parent and isCookable(item) then
                    cookItem(item)
                end
                task.wait(0.012)
            end
        end

        -- Cooked replacements appear quickly; do not stall patrol for 3 seconds.
        task.wait(0.65)
        if (getRealHunger() or state.maxHunger) <= state.eatThreshold then
            attemptAutoEat()
        end
    end)

    state.lastFoodService = os.clock()
    state.foodServiceRunning = false
    if not serviceOk and state.autoFarm then
        state.emergencyFoodRun = true
    end
end

