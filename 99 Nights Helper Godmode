    end
end)

--==============================================================
-- SILENT FOOD FALLBACK
-- Cooked food is always preferred. Raw food is used only if no
-- cooked food succeeds.
--==============================================================

local RAW_COOKABLE_NAMES = {
    ["Morsel"] = true,
    ["Steak"] = true,
    ["Ribs"] = true,
    ["Salmon"] = true,
    ["Mackerel"] = true,
    ["Clownfish"] = true,
    ["Swordfish"] = true,
    ["Jellyfish"] = true,
    ["Char"] = true,
    ["Eel"] = true,
    ["Shark"] = true,
}

local function isCooked(item)
    return string.sub(item.Name, 1, 7) == "Cooked "
end

local function isCookable(item)
    if not item or isCooked(item) then
        return false
    end

    if RAW_COOKABLE_NAMES[item.Name] then
        return true
    end

    local value = item:GetAttribute("Cookable")
    return value ~= nil and value ~= false
end

local function isFoodItem(item)
    if not item then
        return false
    end

    local restore = tonumber(item:GetAttribute("RestoreHunger"))
    return (restore and restore > 0) or isCooked(item) or isCookable(item)
end

local failedFoodUntil = setmetatable({}, { __mode = "k" })

local function canConsume(item)
    if not item or not item.Parent then
        return false
    end

    local restore = tonumber(item:GetAttribute("RestoreHunger"))
    if not restore or restore <= 0 then
        return false
    end

    local owner = item:GetAttribute("Owner")
    if owner ~= nil and owner ~= player.UserId then
        return false
    end

    if player:GetAttribute("Class") == "Bunny" and item:GetAttribute("HasMeat") then
        return false
    end

    return true
end

local function dragItemTo(item, destination)
    if not item or not item.Parent or not StartDragging or not StopDragging then
        return false
    end

    local ok = pcall(function()
        StartDragging:FireServer(item)
        task.wait(0.025)

        if item:IsA("Model") then
            item:PivotTo(destination)
        elseif item:IsA("BasePart") then
            item.CFrame = destination
        end

        task.wait(0.025)
        StopDragging:FireServer(item)
    end)

    return ok
end

local function getFoodCandidates()
    local candidates = {}
    local root = getRoot()
    local now = os.clock()

    local sources = {
        player:FindFirstChild("Inventory"),
        player:FindFirstChild("Backpack"),
        workspace:FindFirstChild("Items"),
    }

    for sourceIndex, container in ipairs(sources) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if (not failedFoodUntil[item] or failedFoodUntil[item] <= now)
                    and canConsume(item) then

                    local restore = tonumber(item:GetAttribute("RestoreHunger")) or 0
                    local distance = 0
                    local part = getPart(item)

                    if root and part then
                        distance = (part.Position - root.Position).Magnitude
                    end

                    -- Priority: cooked food > ready-to-eat raw food > raw meat.
                    -- This avoids the game's "cook meat before eating" warning
                    -- whenever another valid food exists.
                    local cookedBonus = isCooked(item) and 1000000000 or 0
                    local rawMeatPenalty = (item:GetAttribute("HasMeat") and not isCooked(item)) and 500000000 or 0
                    local sourceBonus = (4 - sourceIndex) * 1000000
                    local score = cookedBonus + sourceBonus + restore * 10000 - distance - rawMeatPenalty

                    table.insert(candidates, {
                        item = item,
                        score = score,
                    })
                end
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.score > b.score
    end)

    return candidates
end

local function consumeFood(item)
    if not item or not item.Parent or not RequestConsumeItem then
        return false
    end

    local root = getRoot()
    if not root then
        return false
    end

    -- Bring world food into a normal server-valid range first.
    if item:IsDescendantOf(workspace) then
        local part = getPart(item)
        if part and (part.Position - root.Position).Magnitude > 12 then
            dragItemTo(item, root.CFrame * CFrame.new(0, 1, -3))
            task.wait(0.06)
        end
    end

    local before = getRealHunger()

    -- Do NOT reparent the live item into TempStorage here. On consumed/destroyed
    -- items that can produce Roblox's "trying to set locked parent!" warning.
    -- The current server accepts nearby items through RequestConsumeItem directly.
    local success, response = pcall(function()
        if RequestConsumeItem:IsA("RemoteFunction") then
            return RequestConsumeItem:InvokeServer(item)
        else
            RequestConsumeItem:FireServer(item)
            return true
        end
    end)

    task.wait(0.10)

    local after = getRealHunger()
    local accepted = success and (
        response == true
        or (type(response) == "table" and response.Success == true)
        or (before ~= nil and after ~= nil and after > before)
    )

    if accepted then
        return true
    end

    if item and item.Parent then
        failedFoodUntil[item] = os.clock() + 2
    end

    return false
end

local function requestEmergencyFoodRun()
    if not state.autoFarm then
        return
    end

    state.emergencyFoodRun = true

    if G.SB99_ACTIVE_TWEEN then
        pcall(function()
            G.SB99_ACTIVE_TWEEN:Cancel()
        end)
    end
end

local function attemptAutoEat()
    if state.eatBusy then
        return false
    end

    local hunger = getRealHunger()
    if hunger == nil or hunger > state.eatThreshold then
        return false
    end

    local foods = getFoodCandidates()
    if #foods == 0 then
        requestEmergencyFoodRun()
        return false
    end

    state.eatBusy = true
    local success = false

    -- Sorted list guarantees cooked food is tried before raw food.
    for index = 1, math.min(8, #foods) do
        local item = foods[index].item
        if item and item.Parent and consumeFood(item) then
            success = true
            break
        end
    end

    state.eatBusy = false

    if not success then
        requestEmergencyFoodRun()
    end

    return success
end

task.spawn(function()
    while state.active do
        local hunger = getRealHunger()

        if hunger ~= nil and hunger <= state.eatThreshold then
            attemptAutoEat()
            task.wait(hunger <= 40 and 0.1 or 0.3)
        else
            task.wait(0.6)
        end
    end
end)

--==============================================================
-- AXE / SACK RANKING
--==============================================================

local AXE_FALLBACK = {
    ["Old Axe"] = 10,
    ["Good Axe"] = 20,
    ["Strong Axe"] = 30,
    ["Chainsaw"] = 40,
    ["Ice Axe"] = 45,
    ["Corrupted Axe"] = 50,
    ["Brutal BattleAxe"] = 60,
    ["Admin Axe"] = 100,
}

local SACK_FALLBACK = {
    ["Old Sack"] = 10,
    ["Good Sack"] = 20,
    ["Giant Sack"] = 30,
    ["Infernal Sack"] = 40,
    ["Admin Sack"] = 100,
}

local function isAxe(item)
    if not item then
        return false
    end

    return AXE_FALLBACK[item.Name] ~= nil
        or string.find(string.lower(item.Name), "axe", 1, true) ~= nil
        or item.Name == "Chainsaw"
end

local function axeScore(item)
    if not isAxe(item) then
        return -math.huge
    end

    local priority = tonumber(item:GetAttribute("ToolPriority")) or 0
    local resourceDamage = tonumber(item:GetAttribute("WeaponResourceDamage")) or 0
    local entityDamage = tonumber(item:GetAttribute("WeaponDamage")) or 0

    return priority * 1000000
        + resourceDamage * 10000
        + entityDamage * 100
        + (AXE_FALLBACK[item.Name] or 1)
end

local function isSack(item)
    if not item then
        return false
    end

    return SACK_FALLBACK[item.Name] ~= nil
        or string.find(string.lower(item.Name), "sack", 1, true) ~= nil
end

local function sackScore(item)
    if not isSack(item) then
        return -math.huge
    end

    local capacity = tonumber(item:GetAttribute("Capacity")) or 0
    return capacity * 1000 + (SACK_FALLBACK[item.Name] or 1)
end

local function ownedContainers()
    return {
        player:FindFirstChild("Inventory"),
        player:FindFirstChild("Backpack"),
        player.Character,
    }
end

local function findBestOwned(scoreFunction)
    local best = nil
    local bestScore = -math.huge

    for _, container in ipairs(ownedContainers()) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                local score = scoreFunction(item)
                if score > bestScore then
                    best = item
                    bestScore = score
                end
            end
        end
    end

    return best, bestScore
end

local function findBestWorld(scoreFunction)
    local items = workspace:FindFirstChild("Items")
    if not items then
        return nil, -math.huge
    end

    local best = nil
    local bestScore = -math.huge

    for _, item in ipairs(items:GetChildren()) do
        local score = scoreFunction(item)
        if score > bestScore then
            best = item
            bestScore = score
        end
    end

    return best, bestScore
end

local function requestHotbarPickup(item)
    if not item or not item.Parent or not RequestHotbarItem then
        return false
    end

    local success, response = pcall(function()
        if RequestHotbarItem:IsA("RemoteFunction") then
            return RequestHotbarItem:InvokeServer(item)
        else
            RequestHotbarItem:FireServer(item)
            return true
        end
    end)

    return success and (
        response == true
        or (type(response) == "table" and response.Success == true)
    )
end

local gearCooldown = setmetatable({}, { __mode = "k" })

local function grabUpgrade(item, scoreFunction)
    if not item or not item.Parent then
        return
    end

    local now = os.clock()
    if gearCooldown[item] and gearCooldown[item] > now then
        return
    end

    gearCooldown[item] = now + 3

    local root = getRoot()
    if not root then
        return
    end

    task.spawn(function()
        dragItemTo(item, root.CFrame * CFrame.new(0, 1, -3))
        task.wait(0.08)
        requestHotbarPickup(item)
        task.wait(0.35)
    end)
end

task.spawn(function()
    while state.active do
        if state.autoBestGear then
            local _, ownedAxeScore = findBestOwned(axeScore)
            local _, ownedSackScore = findBestOwned(sackScore)
            local worldAxe, worldAxeScore = findBestWorld(axeScore)
            local worldSack, worldSackScore = findBestWorld(sackScore)

            if worldAxe and worldAxeScore > ownedAxeScore then
                grabUpgrade(worldAxe, axeScore)
            end

            if worldSack and worldSackScore > ownedSackScore then
                grabUpgrade(worldSack, sackScore)
            end
        end

        task.wait(0.4)
    end
end)

