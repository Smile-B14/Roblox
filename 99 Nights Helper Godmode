local PROTECTED_RESOURCE_PATTERNS = {
    "ammo", "armor", "bandage", "medkit", "revolver", "rifle", "shotgun",
    "spear", "sword", "crossbow", "flashlight", "lantern", "key", "map",
    "compass", "fishing rod", "flute", "gem", "coin", "seed", "tablet",
}

local function lowerName(item)
    return item and string.lower(item.Name) or ""
end

local function isLogResource(item)
    local name = lowerName(item)
    return name == "log"
        or string.find(name, " log", 1, true) ~= nil
        or string.find(name, "log ", 1, true) ~= nil
end

local function isFuelResource(item)
    if not item then
        return false
    end
    local name = lowerName(item)
    if FUEL_NAMES[name] or isLogResource(item) then
        return true
    end

    local fuel = tonumber(item:GetAttribute("FuelAmount"))
        or tonumber(item:GetAttribute("FuelValue"))
        or tonumber(item:GetAttribute("BurnValue"))
        or tonumber(item:GetAttribute("Fuel"))
    return fuel ~= nil and fuel > 0
end

local function isProtectedResourceItem(item)
    if not item then
        return true
    end
    if isFoodItem(item) or isAxe(item) or isSack(item) then
        return true
    end

    local name = lowerName(item)
    for _, pattern in ipairs(PROTECTED_RESOURCE_PATTERNS) do
        if string.find(name, pattern, 1, true) then
            return true
        end
    end
    return false
end

local function isScrapResource(item)
    if not item or isProtectedResourceItem(item) then
        return false
    end

    -- Current game marks generic craft/scrap objects directly.
    if item:GetAttribute("Scrappable") == true then
        return true
    end

    local name = lowerName(item)
    if SCRAP_NAMES[name] then
        return true
    end

    local scrap = tonumber(item:GetAttribute("Scrap"))
        or tonumber(item:GetAttribute("ScrapValue"))
        or tonumber(item:GetAttribute("WoodValue"))
    if scrap ~= nil and scrap > 0 then
        return true
    end

    return string.find(name, "scrap", 1, true) ~= nil
        or string.find(name, "junk", 1, true) ~= nil
        or string.find(name, "metal", 1, true) ~= nil
        or string.find(name, "chair", 1, true) ~= nil
        or string.find(name, "washing machine", 1, true) ~= nil
        or string.find(name, "car engine", 1, true) ~= nil
        or string.find(name, "microwave", 1, true) ~= nil
        or string.find(name, "broken fan", 1, true) ~= nil
        or string.find(name, "radio", 1, true) ~= nil
        or string.find(name, "furniture", 1, true) ~= nil
        or string.find(name, "stool", 1, true) ~= nil
        or string.find(name, "cabinet", 1, true) ~= nil
        or string.find(name, "shelf", 1, true) ~= nil
    end

local resourceCooldown = setmetatable({}, { __mode = "k" })

local function resourceTarget(item, campfireMaxed, fuelRatio)
    -- Before Level 6, every usable fuel source is reserved for the fire.
    if not campfireMaxed then
        return isFuelResource(item) and CAMPFIRE_DROP or nil
    end

    -- At Level 6, logs and scrappable/furniture/metal become crafting
    -- resources even if the game also considers some furniture fuel.
    if isLogResource(item) or isScrapResource(item) then
        return SCRAP_DROP
    end

    -- Coal/canisters/oil/biofuel are kept for maintenance only.
    if isFuelResource(item)
        and fuelRatio ~= nil
        and fuelRatio < state.campfireMaintainThreshold then
        return CAMPFIRE_DROP
    end
    return nil
end

local function runResourceService()
    if not state.active
        or not state.smartResources
        or state.resourceServiceRunning
        or state.foodServiceRunning
        or state.childRescueRunning then
        return
    end

    state.resourceServiceRunning = true
    pcall(function()
        local level = getCampfireLevel()
        local campfireMaxed = level ~= nil and level >= state.campfireTargetLevel
        local fuelRatio = getCampfireFuelRatio()
        local now = os.clock()

        if campfireMaxed
            and state.autoFarm
            and not state.childRescueCompleted
            and state.childRescueAttempts < state.childRescueMaxAttempts
            and now >= state.nextChildRescueAt then
            state.childRescuePending = true
            cancelFarmTween()
        end

        local items = workspace:FindFirstChild("Items")
        if not items then
            return
        end

        local processed = 0
        for _, item in ipairs(items:GetChildren()) do
            if not state.active or not state.smartResources then
                break
            end

            local cooldown = resourceCooldown[item]
            if item.Parent and (not cooldown or cooldown <= now) then
                local target = resourceTarget(item, campfireMaxed, fuelRatio)
                if target then
                    resourceCooldown[item] = now + 1.5
                    if dragItemTo(item, CFrame.new(target)) then
                        processed = processed + 1
                        task.wait(0.015)

                        if target == CAMPFIRE_DROP then
                            local updatedLevel = getCampfireLevel()
                            if updatedLevel ~= nil and updatedLevel >= state.campfireTargetLevel then
                                campfireMaxed = true
                                fuelRatio = getCampfireFuelRatio()
                            elseif campfireMaxed then
                                fuelRatio = getCampfireFuelRatio()
                            end
                        end
                    end
                end
            end

            if processed >= state.resourcePassLimit then
                break
            end
        end
    end)
    state.resourceServiceRunning = false
end

local promptOriginals = G.SB99_PROMPT_ORIGINALS
local promptSet = setmetatable({}, { __mode = "k" })
local promptCooldown = setmetatable({}, { __mode = "k" })

local function setPromptInstant(prompt)
    if not prompt or not prompt.Parent then
        return
    end

    if promptOriginals[prompt] == nil then
        local ok, original = pcall(function()
            return {
                holdDuration = prompt.HoldDuration,
                requiresLineOfSight = prompt.RequiresLineOfSight,
                maxActivationDistance = prompt.MaxActivationDistance,
            }
        end)
        if ok then
            promptOriginals[prompt] = original
        end
    end

    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, state.promptRange)
    end)
end

local function restoreInstantPrompts()
    for prompt, original in pairs(promptOriginals) do
        if prompt and prompt.Parent and type(original) == "table" then
            pcall(function()
                prompt.HoldDuration = original.holdDuration
                prompt.RequiresLineOfSight = original.requiresLineOfSight
                prompt.MaxActivationDistance = original.maxActivationDistance
            end)
        end
    end
end

local function registerPrompt(descendant)
    if descendant and descendant:IsA("ProximityPrompt") then
        promptSet[descendant] = true
        if state.autoFarm then
