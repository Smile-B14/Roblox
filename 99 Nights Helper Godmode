-- Main Auto Farm controller.
task.spawn(function()
    local wasNight = false

    while state.active do
        if not state.autoFarm then
            wasNight = false
            task.wait(0.4)
        else
            -- Stronghold owns movement completely. This check happens before
            -- night detection, so night can never pull the player underground
            -- while waves/chest/diamond verification are in progress.
            if state.strongholdControl then
                state.releaseFarmForStronghold()
                wasNight = false
                task.wait(0.25)
                continue
            end

            local night = isNight()

            -- NIGHT: stay directly under center. No roaming.
            if night then
                if not wasNight then
                    cancelFarmTween()
                end

                local character = getCharacter()
                local root = getRoot()
                if character and (not root or (root.Position - FARM_HOME).Magnitude > 1.5) then
                    pcall(character.PivotTo, character, CFrame.new(FARM_HOME))
                end
                lockFarmCharacter()

                wasNight = true

                -- Food is still brought/cooked every minute at night.
                if state.emergencyFoodRun or foodServiceDue() then
                    runFoodService()
                end

                task.wait(0.5)
            else
                wasNight = false

                -- After Level 6, rescuing children has priority during daytime.
                if state.childRescuePending and not state.childRescueRunning then
                    runChildRescueAttempt()
                    task.wait(0.2)
                -- Food service has priority over roaming.
                elseif state.emergencyFoodRun or foodServiceDue() then
                    moveFarmTo(FARM_HOME, true)
                    runFoodService()
                    task.wait(0.2)
                else
                    local point = patrolPoints[state.patrolIndex]

                    if moveFarmTo(point, false) then
                        state.patrolIndex = state.patrolIndex + 1

                        -- After a complete sweep, return home before starting again.
                        if state.patrolIndex > #patrolPoints then
                            state.patrolIndex = 1
                            moveFarmTo(FARM_HOME, true)
                            task.wait(1)
                        else
                            task.wait(0.3)
                        end
                    else
                        task.wait(0.1)
                    end
                end
            end
        end
    end
end)

