local function ensureAxeArmed(weapon)
    if not weapon or not weapon.Parent then
        return
    end

    if not isLive(EquipItemHandle) then
        refreshRemotes()
        if not isLive(EquipItemHandle) then
            return
        end
    end

    local now = os.clock()
    if weapon == lastArmed and now - lastArmTime < 1 then
        return
    end

    local equipRemote = EquipItemHandle
    local worked, response = callUtilityRemote(equipRemote, 0.75, "FireAllClients", weapon)
    local armed = worked and response ~= false

    if not armed then
        worked, response = callUtilityRemote(equipRemote, 0.75, weapon)
        armed = worked and response ~= false
    end

    -- Preserve the one-second throttle even if the remote rejects the
    -- request, otherwise every target would immediately retry equip.
    lastArmed = weapon
    lastArmTime = now
end

