local function getPart(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChild("HumanoidRootPart")
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function isLive(instance)
    return typeof(instance) == "Instance" and instance.Parent ~= nil
end

-- Utility RemoteFunctions are isolated behind a timeout guard. Each call owns
-- a tokenized expiring lock. A timed-out InvokeServer also enters a short
-- circuit-breaker cooldown so a permanently hung server remote cannot leak a
-- new waiting coroutine every couple of seconds. Late responses only clear
-- the cooldown that belongs to their own token, so newer calls stay isolated.
local invokeLocks = setmetatable({}, { __mode = "k" })
local invokeCooldowns = setmetatable({}, { __mode = "k" })

local function callUtilityRemote(remote, timeoutSeconds, ...)
    if not isLive(remote) then
        return false, nil
    end

    if remote:IsA("RemoteEvent") then
        local ok = pcall(remote.FireServer, remote, ...)
        return ok, ok and true or nil
    end

    if not remote:IsA("RemoteFunction") then
        return false, nil
    end

    local timeout = math.max(0.25, tonumber(timeoutSeconds) or 2)
    local now = os.clock()

    local cooldown = invokeCooldowns[remote]
    if cooldown then
        if cooldown.untilAt > now then
            return false, nil
        end
        invokeCooldowns[remote] = nil
    end

    local existing = invokeLocks[remote]
    if existing and existing.expiresAt > now then
        return false, nil
    end

    local args = table.pack(...)
    local token = {}
    local done = false
    local ok = false
    local result = nil

    invokeLocks[remote] = {
        token = token,
        expiresAt = now + timeout + 0.75,
    }

    local invokeThread
    invokeThread = task.spawn(function()
        ok, result = pcall(remote.InvokeServer, remote, table.unpack(args, 1, args.n))
        done = true

        local activeLock = invokeLocks[remote]
        if activeLock and activeLock.token == token then
            invokeLocks[remote] = nil
        end

        local activeCooldown = invokeCooldowns[remote]
        if activeCooldown and activeCooldown.token == token then
            invokeCooldowns[remote] = nil
        end
    end)

    local deadline = now + timeout
    while state.active and not done and os.clock() < deadline do
        task.wait()
    end

    if not done then
        if type(task.cancel) == "function" and invokeThread then
            pcall(task.cancel, invokeThread)
        end

        local activeLock = invokeLocks[remote]
        if activeLock and activeLock.token == token then
            invokeLocks[remote] = nil
        end

        invokeCooldowns[remote] = {
            token = token,
            untilAt = os.clock() + 8,
        }
        return false, nil
    end

    return ok, result
end

