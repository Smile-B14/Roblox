local function restoreFarmNoclip()
    local originals = G.SB99_FARM_COLLISIONS
    if type(originals) ~= "table" then return end
    for part, canCollide in pairs(originals) do
        if typeof(part) == "Instance" and part.Parent and part:IsA("BasePart") then
            pcall(function()
                part.CanCollide = canCollide == true
            end)
        end
    end
    table.clear(originals)
end

local function lockFarmCharacter()
    local humanoid = getHumanoid()
    local root = getRoot()

    if state.autoFarm then
        applyFarmNoclip()
    end

    if humanoid and humanoid.Parent then
        pcall(function()
            if humanoid.WalkSpeed ~= 0 then
                humanoid.WalkSpeed = 0
            end
            if humanoid.AutoRotate then
                humanoid.AutoRotate = false
            end

            if humanoid.UseJumpPower then
                if humanoid.JumpPower ~= 0 then
                    humanoid.JumpPower = 0
                end
            elseif humanoid.JumpHeight ~= 0 then
                humanoid.JumpHeight = 0
            end
        end)
    end

    if root and root.Parent then
        pcall(function()
            if root.AssemblyLinearVelocity.Magnitude > 0.01 then
                root.AssemblyLinearVelocity = Vector3.zero
            end
            if root.AssemblyAngularVelocity.Magnitude > 0.01 then
                root.AssemblyAngularVelocity = Vector3.zero
            end
            local shouldAnchor = (state.nightCampLock == true and not state.strongholdControl)
                or (root.Position.Y < -20 and not state.strongholdControl)
            if root.Anchored ~= shouldAnchor then
                root.Anchored = shouldAnchor
            end
        end)
    end
end

