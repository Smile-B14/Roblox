local function readNumberValue(object, names)
    if not object then
        return nil
    end

    for _, name in ipairs(names) do
        local ok, value = pcall(object.GetAttribute, object, name)
        if ok then
            value = tonumber(value)
            if value ~= nil then
                return value
            end
        end
    end

    for _, name in ipairs(names) do
        local child = object:FindFirstChild(name, true)
        if child then
            local ok, value = pcall(function()
                return child.Value
            end)
            if ok then
                value = tonumber(value)
                if value ~= nil then
                    return value
                end
            end
        end
    end

    return nil
end

local function getCampfireLevel()
    -- Current game path: workspace.Progress is the campfire progression
    -- and reaches 6 at the maximum campfire level.
    local progress = tonumber(workspace:GetAttribute("Progress"))
    if progress ~= nil then
        return math.max(0, math.floor(progress + 0.001))
    end

    local fire = getMainFire()
    if not fire then
        return nil
    end

    local level = readNumberValue(fire, {
        "Level", "FireLevel", "CampfireLevel", "UpgradeLevel", "CurrentLevel",
    })
    if level == nil and fire.Parent then
        level = readNumberValue(fire.Parent, {
            "CampfireLevel", "FireLevel", "CurrentFireLevel", "MainFireLevel",
        })
    end
    if level == nil then
        level = readNumberValue(workspace, {
            "CampfireLevel", "FireLevel", "CurrentFireLevel", "MainFireLevel",
        })
    end

    if level ~= nil then
        return math.max(0, math.floor(level + 0.001))
    end
    return nil
end

local function getCampfireFuelRatio()
    local fire = getMainFire()
    if not fire then
        return nil
    end

    -- Current game path used by the campfire itself.
    local fuelRemaining = tonumber(fire:GetAttribute("FuelRemaining"))
    local fuelTarget = tonumber(fire:GetAttribute("FuelTarget"))
    if fuelRemaining ~= nil and fuelTarget ~= nil and fuelTarget > 0 then
        return math.clamp(fuelRemaining / fuelTarget, 0, 1)
    end

    local percent = readNumberValue(fire, {
        "FuelPercent", "FuelPercentage", "HealthPercent", "HealthPercentage",
    })
    if percent ~= nil then
        if percent > 1 then
            percent = percent / 100
        end
        return math.clamp(percent, 0, 1)
    end

    local current = readNumberValue(fire, {
        "Fuel", "CurrentFuel", "FuelAmount", "Health", "CurrentHealth",
    })
    local maximum = readNumberValue(fire, {
        "MaxFuel", "MaximumFuel", "FuelMax", "MaxHealth", "MaximumHealth",
    })

    if current ~= nil and maximum ~= nil and maximum > 0 then
        return math.clamp(current / maximum, 0, 1)
    end
    if current ~= nil and current >= 0 and current <= 1 then
        return current
    end
    if current ~= nil and current >= 0 and current <= 100 then
        return current / 100
    end

    return nil
end

local FUEL_NAMES = {
