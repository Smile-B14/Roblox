        return #itemBag:GetChildren()
    end
    return #sack:GetChildren()
end

local function chooseRescueSack(requiredSlots)
    local best = nil
    local bestFits = false
    local bestCount = math.huge
    local bestFree = -1

    for _, container in ipairs(ownedContainers()) do
        for _, item in ipairs(container:GetChildren()) do
            if isSack(item) then
                local count = getSackStoredCount(item)
                local capacity = tonumber(item:GetAttribute("Capacity")) or 0
                local free = math.max(0, capacity - count)
                local fits = free >= requiredSlots

                if (fits and not bestFits)
                    or (fits == bestFits and fits and (count < bestCount or (count == bestCount and free > bestFree)))
                    or (not fits and not bestFits and free > bestFree) then
                    best = item
                    bestFits = fits
                    bestCount = count
                    bestFree = free
                end
            end
        end
    end

    return best, bestFree
end

