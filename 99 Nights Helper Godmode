local function simulateUnstoreKey()
    local vimOk, vim = pcall(game.GetService, game, "VirtualInputManager")
    if vimOk and vim then
        local pressed = pcall(vim.SendKeyEvent, vim, true, Enum.KeyCode.F, false, game)
        if pressed then
            task.wait(2.35)
            pcall(vim.SendKeyEvent, vim, false, Enum.KeyCode.F, false, game)
            return true
        end
    end

    local press = rawget(G, "keypress")
    local release = rawget(G, "keyrelease")
    if type(press) == "function" and type(release) == "function" then
        local ok = pcall(press, 0x46)
        if ok then
