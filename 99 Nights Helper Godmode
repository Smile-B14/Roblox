    if not ballDragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        ballDragging = false

        if not ballMoved and ball.Visible then
            restoreUI()
        end
    end
end))

