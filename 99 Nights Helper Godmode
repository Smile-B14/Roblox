local function unstoreSackAtCamp(sack)
    if not sack or not sack.Parent then
        return false
    end

    local character = getCharacter()
    if character then
        pcall(character.PivotTo, character, CFrame.new(CAMPFIRE_DROP + Vector3.new(0, 3, 4)))
    end
    lockFarmCharacter()
    equipOwnedItem(sack)
    focusCameraAt(CAMPFIRE_DROP)

    local before = getSackStoredCount(sack)
    local droppedAny = false
    local itemBag = getItemBag()

    -- Current game path: bag contents are mirrored under LocalPlayer.ItemBag
    -- and RequestBagDropItem(sack, item) drops one exact object.
    if not isLive(RequestBagDropItem) then
        refreshRemotes()
    end
    if isLive(RequestBagDropItem) and itemBag then
        local bagged = itemBag:GetChildren()
        for _, item in ipairs(bagged) do
            if not state.autoFarm then
                break
            end
            if isLostChild(item) then
                state.childRescueObserved[item.Name] = true
                local wasParent = item.Parent
                local ok = callUtilityRemote(RequestBagDropItem, 0.75, sack, item)
                if ok then
                    task.wait(0.12)
                    local movedOutOfBag = item.Parent ~= wasParent
                    local rescuedAtCamp = childIsAtCamp(item)
                    if movedOutOfBag or rescuedAtCamp then
                        state.childRescueVerified[item.Name] = true
                        droppedAny = true
                    end
                end
            end
        end
        task.wait(0.35)
    end

    local afterExact = getSackStoredCount(sack)
    if not droppedAny and afterExact >= before then
        local remote = findBagUnstoreRemote()
        if remote and remote ~= RequestBagDropItem and before > 0 then
            for _ = 1, math.min(before, 12) do
                callUtilityRemote(remote, 0.75, sack)
                task.wait(0.04)
            end
            task.wait(0.25)
        end
    end

    local afterRemote = getSackStoredCount(sack)
    if not droppedAny and afterRemote >= before then
        for _ = 1, 8 do
            activateUnstoreGui()
            task.wait(0.04)
        end
        task.wait(0.2)
    end

    local afterGui = getSackStoredCount(sack)
    if not droppedAny and afterGui >= before then
        simulateUnstoreKey()
    end

    task.wait(0.8)
    local after = getSackStoredCount(sack)
    return droppedAny or after < before
end

local function runChildRescueAttempt()
    if not state.autoFarm
        or state.childRescueRunning
        or state.childRescueCompleted
        or state.childRescueAttempts >= state.childRescueMaxAttempts then
        return false
    end

    local level = getCampfireLevel()
    if level == nil or level < state.campfireTargetLevel then
        return false
    end

    -- MissingKids stores the map positions used to reveal children
    -- that are not currently replicated in workspace.Characters.
    discoverMissingChildren()
    task.wait(0.25)

    local children = getUnrescuedChildren()
    if verifiedChildCount() >= 4 then
        state.childRescueCompleted = true
        state.childRescuePending = false
        return true
    end
    -- Never treat an empty replication snapshot as success. If fewer
    -- than four children have been verified, retry discovery later.
    if #children == 0 then
        return false
    end

    state.childRescueRunning = true
    state.childRescuePending = false
    state.childRescueAttempts = state.childRescueAttempts + 1
    cancelFarmTween()

    local camera = workspace.CurrentCamera
    local oldCameraType = camera and camera.CameraType
    local oldCameraSubject = camera and camera.CameraSubject
    local oldCameraCFrame = camera and camera.CFrame
    if camera then
        pcall(function()
            camera.CameraType = Enum.CameraType.Scriptable
        end)
    end

    local success = false
    pcall(function()
        local sack, freeSlots = chooseRescueSack(#children)
        if not sack or freeSlots <= 0 then
            return
        end

        local stored = 0
        for _, child in ipairs(children) do
            if not state.autoFarm then
                break
            end
            if storeChildInSack(sack, child) then
                stored = stored + 1
            end
            task.wait(0.08)
        end

        if stored <= 0 then
            return
        end

        local beforeDrop = getSackStoredCount(sack)
        local dropped = unstoreSackAtCamp(sack)
        task.wait(2)
        local afterDrop = getSackStoredCount(sack)
        local sackVerified = dropped and afterDrop < beforeDrop
        getUnrescuedChildren() -- refresh Lost/rescue attributes after the drop
        success = sackVerified and verifiedChildCount() >= 4
    end)

    if camera then
        pcall(function()
            if oldCameraCFrame then
                camera.CFrame = oldCameraCFrame
            end
            if oldCameraSubject then
                camera.CameraSubject = oldCameraSubject
            end
            if oldCameraType then
                camera.CameraType = oldCameraType
            else
                camera.CameraType = Enum.CameraType.Custom
            end
        end)
    end

    if state.autoFarm then
        local character = getCharacter()
        if character then
            pcall(character.PivotTo, character, CFrame.new(FARM_HOME))
        end
        lockFarmCharacter()
    end

    state.childRescueRunning = false
    if success then
        state.childRescueCompleted = true
        state.childRescuePending = false
    else
        state.nextChildRescueAt = os.clock() + 5
        state.childRescuePending = false
    end
    return success
end

local function moveFarmTo(position, ignoreInterrupts)
    if not state.autoFarm then
        return false
    end

    local root = getRoot()
    if not root or not root.Parent then
        return false
    end

    lockFarmCharacter()

    local distance = (root.Position - position).Magnitude
    local duration = math.max(0.15, distance / state.patrolSpeed)
    local created, tween = pcall(
        TweenService.Create,
        TweenService,
        root,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(position) }
    )
    if not created or not tween then
        return false
    end

    G.SB99_ACTIVE_TWEEN = tween
    if not pcall(tween.Play, tween) then
        if G.SB99_ACTIVE_TWEEN == tween then
            G.SB99_ACTIVE_TWEEN = nil
        end
        return false
    end

    local deadline = os.clock() + duration + 2
    while state.active and state.autoFarm do
        local stateOk, playbackState = pcall(function()
            return tween.PlaybackState
        end)
        if not stateOk or playbackState ~= Enum.PlaybackState.Playing then
            break
        end

        if not root.Parent or os.clock() >= deadline then
            pcall(tween.Cancel, tween)
            break
        end

        if not ignoreInterrupts
            and (state.emergencyFoodRun or foodServiceDue() or isNight() or state.childRescuePending or state.childRescueRunning) then
            pcall(tween.Cancel, tween)
            break
        end

        task.wait(0.1)
    end

    if G.SB99_ACTIVE_TWEEN == tween then
        G.SB99_ACTIVE_TWEEN = nil
    end

    local stateOk, playbackState = pcall(function()
        return tween.PlaybackState
    end)
    return stateOk and playbackState == Enum.PlaybackState.Completed
end

local function cookItem(item)
