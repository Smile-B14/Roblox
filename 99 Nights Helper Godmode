local patrolPoints = {}

-- Four rings out to 700 studs. Offset alternating rings so coverage overlaps.
for ring = 1, 4 do
    local radius = ring * (state.patrolRadius / 4)

    for point = 0, 7 do
        local offsetDegrees = (ring % 2 == 0) and 22.5 or 0
        local angle = math.rad(point * 45 + offsetDegrees)

        table.insert(patrolPoints, Vector3.new(
            math.cos(angle) * radius,
            FARM_PATROL_Y,
            math.sin(angle) * radius
        ))
    end
end

local function enableFarm()
    if state.autoFarm then
        return
    end

    local humanoid = getHumanoid()

    previousFarm.chop = state.autoChop
    previousFarm.kill = state.killAura
    previousFarm.gear = state.autoBestGear
    previousFarm.smart = state.smartResources
    previousFarm.plant = state.autoPlant
    previousFarm.build = state.autoCampBuild
    previousFarm.chest = state.autoChest
    previousFarm.child = state.autoChildRescue
    previousFarm.diamond = state.diamondFarm

    if humanoid then
        previousFarm.walkSpeed = humanoid.WalkSpeed
        previousFarm.jumpPower = humanoid.JumpPower
        previousFarm.jumpHeight = humanoid.JumpHeight
        previousFarm.autoRotate = humanoid.AutoRotate
    end

    G.SB99_FARM_RESTORE = {
        walkSpeed = previousFarm.walkSpeed,
        jumpPower = previousFarm.jumpPower,
        jumpHeight = previousFarm.jumpHeight,
        autoRotate = previousFarm.autoRotate,
    }

    state.autoFarm = true
    state.autoChop = true
    state.killAura = true
    state.autoBestGear = true
    state.smartResources = true
    state.autoPlant = true
    state.autoCampBuild = true
    state.autoChest = true
    state.autoChildRescue = true
    state.diamondFarm = true
    state.patrolIndex = 1
    state.childRescueAttempts = 0
    state.childRescueRunning = false
    state.childRescuePending = false
    state.childRescueCompleted = false
    state.childRescueObserved = {}
    state.childRescueVerified = {}
    state.nextChildRescueAt = 0

    -- Immediate first food sweep, then every minute.
    state.lastFoodService = 0

    createPlatform()
    setAllPromptsInstant()

    local character = getCharacter()
    if character then
        pcall(character.PivotTo, character, CFrame.new(FARM_HOME))
    end

    lockFarmCharacter()
end

local function disableFarm()
    if not state.autoFarm then
        return
    end

    state.autoFarm = false
    state.emergencyFoodRun = false
    state.foodServiceRunning = false
    state.childRescuePending = false
    state.childRescueRunning = false
    state.saplingServiceRunning = false
    state.campBuildRunning = false

    cancelFarmTween()

    state.autoChop = previousFarm.chop
    state.killAura = previousFarm.kill
    state.autoBestGear = previousFarm.gear
    state.smartResources = previousFarm.smart
    state.autoPlant = previousFarm.plant
    state.autoCampBuild = previousFarm.build
    state.autoChest = previousFarm.chest
    state.autoChildRescue = previousFarm.child
    state.diamondFarm = previousFarm.diamond

    local humanoid = getHumanoid()
    local root = getRoot()
    local character = getCharacter()

    if root then
        pcall(function()
            root.Anchored = false
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    if humanoid then
        pcall(function()
            humanoid.WalkSpeed = previousFarm.walkSpeed
            humanoid.AutoRotate = previousFarm.autoRotate

            if humanoid.UseJumpPower then
                humanoid.JumpPower = previousFarm.jumpPower
            else
                humanoid.JumpHeight = previousFarm.jumpHeight
            end
        end)
    end

    destroyPlatform()
    restoreInstantPrompts()

    if character then
        pcall(character.PivotTo, character, CFrame.new(RETURN_POSITION))
    end

    G.SB99_FARM_RESTORE = nil
end

