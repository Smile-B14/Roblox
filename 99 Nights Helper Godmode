        end
    end)
end

task.spawn(function()
    while state.active do
        if state.autoBestGear then
            local _, ownedAxeScore = findBestOwned(axeScore)
            local _, ownedSackScore = findBestOwned(sackScore)
            local worldAxe, worldAxeScore = findBestWorld(axeScore)
            local worldSack, worldSackScore = findBestWorld(sackScore)

            if worldAxe and worldAxeScore > ownedAxeScore then
                grabUpgrade(worldAxe)
            end

            if worldSack and worldSackScore > ownedSackScore then
                grabUpgrade(worldSack)
            end
        end

        -- Keep active gear acquisition responsive without burning cycles while off.
        task.wait(state.autoBestGear and 0.4 or 1.2)
    end
end)

