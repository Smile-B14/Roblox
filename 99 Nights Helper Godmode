local AXE_FALLBACK = {
    ["Old Axe"] = 10,
    ["Good Axe"] = 20,
    ["Strong Axe"] = 30,
    ["Chainsaw"] = 40,
    ["Ice Axe"] = 45,
    ["Corrupted Axe"] = 50,
