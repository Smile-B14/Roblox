local attackCooldown = setmetatable({}, { __mode = "k" })

local function attackTarget(target, isTree)
    if not isLive(ToolDamageObject) then
        refreshRemotes()
        if not isLive(ToolDamageObject) then
            return
        end
    end

    if not target or not target.Parent or state.inflight >= state.maxInflight then
        return
    end

    if not isTree then
        local humanoid = target:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health <= 0 then
            return
        end
    end

    local root = getRoot()
    local weapon = bestAxe
    if not root or not root.Parent or not weapon or not weapon.Parent then
        return
    end

    local now = os.clock()
    local previous = attackCooldown[target]
    if previous and now - previous < state.targetCooldown then
        return
    end

    local hitId = makeHitId(weapon)
    if not hitId then
        return
    end

    attackCooldown[target] = now
    ensureAxeArmed(weapon)

    local remote = ToolDamageObject
    local attackCFrame = root.CFrame

    -- RemoteEvents do not yield, so avoid spawning thousands of tiny tasks.
    if remote:IsA("RemoteEvent") then
        state.inflight = state.inflight + 1
        pcall(remote.FireServer, remote, target, weapon, hitId, attackCFrame)
        state.inflight = math.max(0, state.inflight - 1)
        return
    end

    if not remote:IsA("RemoteFunction") then
        return
    end

    state.inflight = state.inflight + 1
    local released = false
    local function releaseInflight()
        if released then
            return
        end
        released = true
        state.inflight = math.max(0, state.inflight - 1)
    end

    -- Bound both the inflight counter and the suspended coroutine. Executors
    -- that support task.cancel will not accumulate permanently hung invokes.
    local attackThread
    attackThread = task.spawn(function()
        pcall(remote.InvokeServer, remote, target, weapon, hitId, attackCFrame)
        releaseInflight()
    end)

    task.delay(2, function()
        if released then
            return
        end
        if type(task.cancel) == "function" and attackThread then
            pcall(task.cancel, attackThread)
        end
        releaseInflight()
    end)
end

local treeCache = {}

local function rebuildTrees()
    table.clear(treeCache)

    local map = workspace:FindFirstChild("Map")
    if not map then
        return
