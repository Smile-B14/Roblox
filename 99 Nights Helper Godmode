    ToolDamageObject = findReplicated("ToolDamageObject")
    EquipItemHandle = findReplicated("EquipItemHandle")
    StartDragging = findReplicated("RequestStartDraggingItem")
    StopDragging = findReplicated("StopDraggingItem")
    RequestHotbarItem = findReplicated("RequestHotbarItem")
