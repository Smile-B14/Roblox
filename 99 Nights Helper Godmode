local lastArmed = nil
local lastArmTime = 0

local function ensureAxeArmed(weapon)
    if not weapon or not EquipItemHandle then
        return
    end

    local now = os.clock()
    if weapon == lastArmed and now - lastArmTime < 1 then
        return
    end

    local worked = pcall(function()
        EquipItemHandle:FireServer("FireAllClients", weapon)
    end)

    if not worked then
        pcall(function()
            EquipItemHandle:FireServer(weapon)
        end)
    end

    lastArmed = weapon
    lastArmTime = now
end

local KNOWN_TOKENS = {
    ["Old Axe"] = "3_7367831688",
    ["Good Axe"] = "112_7367831688",
    ["Strong Axe"] = "116_7367831688",
    ["Chainsaw"] = "647_8992824875",
    ["Ice Axe"] = "116_7367831688",
    ["Admin Axe"] = "116_7367831688",
}

local function makeHitId(target, damage, weapon)
    -- Captured token is preferred because it comes from the current game build.
    -- Fixed IDs are the fallback used by current public scripts.
    return state.capturedTokens[weapon.Name]
        or KNOWN_TOKENS[weapon.Name]
        or 999
end

local attackCooldown = setmetatable({}, { __mode = "k" })

local function attackTarget(target, isTree)
    if not ToolDamageObject then
        refreshRemotes()
        if not ToolDamageObject then
            return
        end
    end

    if not target or not target.Parent or state.inflight >= state.maxInflight then
        return
    end

    local root = getRoot()
    local weapon = bestAxe

    if not root or not weapon then
        return
    end

    local now = os.clock()
    local previous = attackCooldown[target]

    if previous and now - previous < state.targetCooldown then
        return
    end

    attackCooldown[target] = now
    ensureAxeArmed(weapon)

    local damage
    if isTree then
        damage = tonumber(weapon:GetAttribute("WeaponResourceDamage"))
            or tonumber(weapon:GetAttribute("WeaponDamage"))
            or 10
    else
        damage = tonumber(weapon:GetAttribute("WeaponDamage")) or 10
    end

    local hitId = makeHitId(target, damage, weapon)
    if not hitId then
        return
    end

    local attackCFrame = root.CFrame
    state.inflight = state.inflight + 1

    task.spawn(function()
        pcall(function()
            if ToolDamageObject:IsA("RemoteFunction") then
                ToolDamageObject:InvokeServer(target, weapon, hitId, attackCFrame)
            else
                ToolDamageObject:FireServer(target, weapon, hitId, attackCFrame)
            end
        end)

        state.inflight = math.max(0, state.inflight - 1)
    end)
end

local treeCache = {}

local function rebuildTrees()
    table.clear(treeCache)

    local map = workspace:FindFirstChild("Map")
    if not map then
        return
    end

    local folders = {
        map:FindFirstChild("Foliage"),
        map:FindFirstChild("Landmarks"),
    }

    local seen = {}

    for _, folder in ipairs(folders) do
        if folder then
            for _, object in ipairs(folder:GetChildren()) do
                if object:IsA("Model")
                    and string.find(string.lower(object.Name), "tree", 1, true)
                    and not seen[object] then
                    seen[object] = true
                    table.insert(treeCache, object)
                end
            end
        end
    end
end

rebuildTrees()

task.spawn(function()
    while state.active do
        rebuildTrees()
        task.wait(1)
    end
end)

local function sortedEntities(root)
    local result = {}
    local folder = workspace:FindFirstChild("Characters")

    if not folder then
        return result
    end

    for _, target in ipairs(folder:GetChildren()) do
        if target:IsA("Model") and target ~= player.Character then
            local part = getPart(target)
            if part then
                local distance = (part.Position - root.Position).Magnitude
                if distance <= state.range then
                    table.insert(result, {
                        target = target,
                        distance = distance,
                    })
                end
            end
        end
    end

    table.sort(result, function(a, b)
        return a.distance < b.distance
    end)

    return result
end

local function sortedTrees(root)
    local result = {}

    for _, tree in ipairs(treeCache) do
        if tree.Parent then
            local part = getPart(tree)
            if part then
                local distance = (part.Position - root.Position).Magnitude
                if distance <= state.range then
                    table.insert(result, {
                        target = tree,
                        distance = distance,
                    })
                end
            end
        end
    end

    table.sort(result, function(a, b)
        return a.distance < b.distance
    end)

    return result
end

task.spawn(function()
    while state.active do
        local root = getRoot()

        if root then
            if state.killAura then
                for _, info in ipairs(sortedEntities(root)) do
                    if state.inflight >= state.maxInflight then
                        break
                    end
                    attackTarget(info.target, false)
                end
            end

            if state.autoChop then
                for _, info in ipairs(sortedTrees(root)) do
                    if state.inflight >= state.maxInflight then
                        break
                    end
                    attackTarget(info.target, true)
                end
            end
        end

        task.wait(state.workerDelay)
    end
end)

--==============================================================
-- NIGHT DETECTION
-- Uses a replicated boolean attribute if the game exposes one;
-- otherwise uses actual Lighting.ClockTime.
--==============================================================

local function isNight()
    local objects = { workspace, Lighting }
    local names = { "IsNight", "Night", "Nighttime" }

    for _, object in ipairs(objects) do
        for _, name in ipairs(names) do
            local value = object:GetAttribute(name)
            if type(value) == "boolean" then
                return value
            end
        end
    end

    local clock = Lighting.ClockTime
    return clock >= 18 or clock < 6
end

