            if string.find(name, "bag", 1, true)
                and (string.find(name, "unstore", 1, true)
                    or string.find(name, "removeitem", 1, true)
                    or string.find(name, "dropitem", 1, true)) then
                return remote
            end
        end
    end
    return nil
end

local function activateUnstoreGui()
