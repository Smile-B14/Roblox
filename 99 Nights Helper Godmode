    return state.rawHunger
end

-- Damage-only hook. No Hunger hooks and no Roblox method calls inside the hook.
if not G.SB99_FINAL_HOOK then
    if type(hookmetamethod) == "function"
        and type(getnamecallmethod) == "function"
        and type(newcclosure) == "function" then

        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local s = G.SB99_STATE
            if not s or not s.active then
                return oldNamecall(self, ...)
            end

            local method = getnamecallmethod()
            local a1, a2, a3 = ...

            if method == "FireServer" or method == "InvokeServer" then
                local remoteName = self.Name

                -- Capture the game's own ToolDamageObject token without calling
                -- any Roblox methods from inside the metamethod hook.
                if remoteName == "ToolDamageObject"
                    and typeof(a2) == "Instance"
                    and a3 ~= nil then
                    local executorCall = false
                    if type(checkcaller) == "function" then
                        executorCall = checkcaller()
                    end
                    if not executorCall then
                        s.capturedTokens[a2.Name] = a3
                    end
                end

                if s.blockedRemotes[remoteName] then
                    if method == "InvokeServer" then
                        return false
                    end
                    return nil
                end
            end

            return oldNamecall(self, ...)
        end))

        G.SB99_FINAL_HOOK = true
    end
end

-- Entity-damage protection. Hunger itself is intentionally untouched so the
-- real Hunger bar can be watched.
local lastSafeCFrame = nil

local function protectCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    local root = character:WaitForChild("HumanoidRootPart", 10)

    if not humanoid or not root then
        return
    end

    lastSafeCFrame = character:GetPivot()

    pcall(function()
        humanoid.BreakJointsOnDeath = false
        humanoid.RequiresNeck = false
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    end)

    if not character:FindFirstChild("SB99_GodForceField") then
        local forceField = Instance.new("ForceField")
        forceField.Name = "SB99_GodForceField"
        forceField.Visible = false
        forceField.Parent = character
    end

    track(humanoid.HealthChanged:Connect(function(health)
        if not state.active then
            return
        end

        if health > 0 and health < humanoid.MaxHealth then
            pcall(function()
                humanoid.Health = humanoid.MaxHealth
            end)
        end
    end))
end

track(player.CharacterAdded:Connect(function(character)
    task.delay(0.1, function()
        if state.active then
            protectCharacter(character)
        end
    end)
end))

if player.Character then
    task.spawn(protectCharacter, player.Character)
end

