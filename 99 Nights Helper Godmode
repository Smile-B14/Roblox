    while state.active do
        local character = getCharacter()
        local humanoid = getHumanoid()
        local root = getRoot()

        if humanoid then
            pcall(function()
                humanoid.BreakJointsOnDeath = false
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                if humanoid.Health < humanoid.MaxHealth then
                    humanoid.Health = humanoid.MaxHealth
                end
            end)
        end

        if character and humanoid and root and not state.autoFarm then
            local destroyY = workspace.FallenPartsDestroyHeight

            if humanoid.FloorMaterial ~= Enum.Material.Air
                and root.Position.Y > destroyY + 80 then
                local pivotOk, pivot = pcall(character.GetPivot, character)
                if pivotOk then
                    lastSafeCFrame = pivot
                end
            end

            if root.Position.Y <= destroyY + 35 then
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end)

                if lastSafeCFrame then
                    pcall(character.PivotTo, character, lastSafeCFrame + Vector3.new(0, 5, 0))
                else
                    pcall(character.PivotTo, character, CFrame.new(RETURN_POSITION))
                end
            end
        end

        task.wait(0.08)
    end
end)

--==============================================================
-- SILENT FOOD FALLBACK
-- Cooked food is always preferred. Raw food is used only if no
-- cooked food succeeds.
--==============================================================

local RAW_COOKABLE_NAMES = {
    ["Morsel"] = true,
    ["Steak"] = true,
    ["Ribs"] = true,
    ["Salmon"] = true,
    ["Mackerel"] = true,
    ["Clownfish"] = true,
    ["Swordfish"] = true,
    ["Jellyfish"] = true,
    ["Char"] = true,
    ["Eel"] = true,
    ["Shark"] = true,
}

local function isCooked(item)
    return string.sub(item.Name, 1, 7) == "Cooked "
end

local function isCookable(item)
    if not item or isCooked(item) then
        return false
    end

    if RAW_COOKABLE_NAMES[item.Name] then
        return true
    end

    -- Attributes are not always strict booleans across game revisions.
    -- Treat only explicit truthy representations as cookable so values such
    -- as 0/"false" do not generate pointless cook requests.
    local value = item:GetAttribute("Cookable")
    if type(value) == "boolean" then
        return value
    elseif type(value) == "number" then
        return value > 0
    elseif type(value) == "string" then
        local normalized = string.lower(value)
        return normalized == "true" or normalized == "1" or normalized == "yes"
    end

    return false
end

local function isFoodItem(item)
    if not item then
        return false
    end

    local restore = tonumber(item:GetAttribute("RestoreHunger"))
    return (restore and restore > 0) or isCooked(item) or isCookable(item)
end

local failedFoodUntil = setmetatable({}, { __mode = "k" })

local function canConsume(item)
    if not item or not item.Parent then
        return false
    end

    local restore = tonumber(item:GetAttribute("RestoreHunger"))
    if not restore or restore <= 0 then
        return false
    end

    local owner = item:GetAttribute("Owner")
    if owner ~= nil then
        local ownerText = tostring(owner)
        local ownerNormalized = string.lower(ownerText)
        local ownerNumber = tonumber(owner)
        local unowned = owner == false
            or ownerText == ""
            or ownerNormalized == "nil"
            or ownerNormalized == "none"
            or ownerNumber == 0
        local belongsToPlayer = owner == player
            or ownerNumber == player.UserId
            or ownerText == tostring(player.UserId)
            or ownerText == player.Name

        if not unowned and not belongsToPlayer then
            return false
        end
    end

    if player:GetAttribute("Class") == "Bunny" and item:GetAttribute("HasMeat") then
        return false
    end

    return true
end

local dragBusy = false

local function acquireDragLock(timeoutSeconds)
    local deadline = os.clock() + math.max(0.05, tonumber(timeoutSeconds) or 0.5)
    while state.active and dragBusy and os.clock() < deadline do
        task.wait()
    end

    if not state.active or dragBusy then
        return false
    end

    dragBusy = true
    return true
end

local function dragItemTo(item, destination)
    if not item or not item.Parent or not state.active then
        return false
    end

    -- Drag remotes may be replaced during round transitions. Refresh
    -- stale references immediately instead of waiting for the poller.
    if not isLive(StartDragging) or not isLive(StopDragging) then
        refreshRemotes()
        if not isLive(StartDragging) or not isLive(StopDragging) then
            return false
        end
    end

    if not acquireDragLock(0.6) then
        return false
    end

    local startRemote = StartDragging
    local stopRemote = StopDragging
    local startedOk, startedResponse = callUtilityRemote(startRemote, 1, item)
    if not startedOk or startedResponse == false then
        dragBusy = false
        return false
    end

    task.wait(0.02)

    local moved = pcall(function()
        if item.Parent and item:IsA("Model") then
            item:PivotTo(destination)
        elseif item.Parent and item:IsA("BasePart") then
            item.CFrame = destination
        end
    end)

    task.wait(0.02)
    callUtilityRemote(stopRemote, 1)
    dragBusy = false

    return moved and item.Parent ~= nil
end

local function getFoodCandidates()
    local candidates = {}
    local root = getRoot()
    local now = os.clock()

    -- Build a compact list. ipairs stops at the first nil slot, so a
    -- missing Inventory must not hide Backpack or world food.
    local sources = {}
    local inventory = player:FindFirstChild("Inventory")
    local backpack = player:FindFirstChild("Backpack")
    local worldItems = workspace:FindFirstChild("Items")

    if inventory then table.insert(sources, inventory) end
    if backpack then table.insert(sources, backpack) end
    if worldItems then table.insert(sources, worldItems) end

    for sourceIndex, container in ipairs(sources) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if (not failedFoodUntil[item] or failedFoodUntil[item] <= now)
                    and canConsume(item) then

                    local restore = tonumber(item:GetAttribute("RestoreHunger")) or 0
                    local distance = 0
                    local part = getPart(item)

                    if root and part then
                        distance = (part.Position - root.Position).Magnitude
                    end

                    -- Priority: cooked food > ready-to-eat raw food > raw meat.
                    -- This avoids the game's "cook meat before eating" warning
                    -- whenever another valid food exists.
                    local cookedBonus = isCooked(item) and 1000000000 or 0
                    local rawMeatPenalty = (item:GetAttribute("HasMeat") and not isCooked(item)) and 500000000 or 0
                    local sourceBonus = (4 - sourceIndex) * 1000000
                    local score = cookedBonus + sourceBonus + restore * 10000 - distance - rawMeatPenalty

                    table.insert(candidates, {
                        item = item,
                        score = score,
                    })
                end
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.score > b.score
    end)

    return candidates
end

local function consumeFood(item)
    if not item or not item.Parent or not state.active then
        return false
    end

    if not isLive(RequestConsumeItem) then
        refreshRemotes()
        if not isLive(RequestConsumeItem) then
            return false
        end
    end

    local root = getRoot()
    if not root then
        return false
    end

    -- Bring world food into a normal server-valid range first.
    if item:IsDescendantOf(workspace) then
        local part = getPart(item)
        if part and (part.Position - root.Position).Magnitude > 12 then
            dragItemTo(item, root.CFrame * CFrame.new(0, 1, -3))
            task.wait(0.06)
        end
    end

    local before = getRealHunger()
    local consumeRemote = RequestConsumeItem
    local remoteIsEvent = consumeRemote:IsA("RemoteEvent")

    -- A successful FireServer only proves the request was sent, not accepted.
    -- RemoteEvents are verified by an observable item removal or Hunger gain,
    -- with a short replication window for higher-ping/mobile sessions.
    local success, response = callUtilityRemote(consumeRemote, 1.5, item)
    if not success then
        if item.Parent then
            failedFoodUntil[item] = os.clock() + 2
        end
        return false
    end

    local explicitSuccess = not remoteIsEvent and (
        response == true
        or (type(response) == "table" and response.Success == true)
    )
    if explicitSuccess then
        return true
    end

    local verifyDeadline = os.clock() + (remoteIsEvent and 0.5 or 0.2)
    repeat
        task.wait(0.05)

        local after = getRealHunger()
        local itemConsumed = not item.Parent
        local hungerIncreased = before ~= nil and after ~= nil and after > before
        if itemConsumed or hungerIncreased then
            return true
        end
    until not state.active or os.clock() >= verifyDeadline

    if item.Parent then
        failedFoodUntil[item] = os.clock() + 2
    end

    return false
end

local function requestEmergencyFoodRun()
    if not state.autoFarm then
        return
    end

    state.emergencyFoodRun = true

    if G.SB99_ACTIVE_TWEEN then
        pcall(function()
            G.SB99_ACTIVE_TWEEN:Cancel()
        end)
    end
end

local function attemptAutoEat()
    if not state.active or state.eatBusy then
        return false
    end

    local hunger = getRealHunger()
    if hunger == nil or hunger > state.eatThreshold then
        return false
    end

    state.eatBusy = true
    local success = false

    local ok = pcall(function()
        local foods = getFoodCandidates()
        if #foods == 0 then
            return
        end

        -- Sorted list guarantees cooked food is tried before raw food.
        for index = 1, math.min(8, #foods) do
            local item = foods[index].item
            if item and item.Parent and consumeFood(item) then
                success = true
                break
            end
        end
    end)

    state.eatBusy = false

    if not ok or not success then
        requestEmergencyFoodRun()
    end

    return success
end

local eatRequested = false
track(player:GetAttributeChangedSignal("Hunger"):Connect(function()
    if not state.active then
        return
