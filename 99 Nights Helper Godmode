local function findReplicated(name)
    if RemoteEvents then
        local direct = RemoteEvents:FindFirstChild(name)
        if direct then
            return direct
        end
    end

    return ReplicatedStorage:FindFirstChild(name, true)
end

local function refreshRemotes()
    RemoteEvents = ReplicatedStorage:FindFirstChild("RemoteEvents")
        or ReplicatedStorage:FindFirstChild("RemoteEvents", true)

    ToolDamageObject = findReplicated("ToolDamageObject")
    EquipItemHandle = findReplicated("EquipItemHandle")
    StartDragging = findReplicated("RequestStartDraggingItem")
    StopDragging = findReplicated("StopDraggingItem")
    RequestHotbarItem = findReplicated("RequestHotbarItem")
    RequestConsumeItem = findReplicated("RequestConsumeItem")
    RequestCookItem = findReplicated("RequestCookItem")
    TempStorage = ReplicatedStorage:FindFirstChild("TempStorage", true)
end

