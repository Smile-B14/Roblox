local AXE_FALLBACK = {
    ["Old Axe"] = 10,
    ["Good Axe"] = 20,
    ["Strong Axe"] = 30,
    ["Chainsaw"] = 40,
    ["Ice Axe"] = 45,
    ["Corrupted Axe"] = 50,
    ["Brutal BattleAxe"] = 60,
    ["Admin Axe"] = 100,
}

local SACK_FALLBACK = {
    ["Old Sack"] = 10,
    ["Good Sack"] = 20,
    ["Giant Sack"] = 30,
    ["Infernal Sack"] = 40,
    ["Admin Sack"] = 100,
}

local function isAxe(item)
    if not item then
        return false
    end

    return AXE_FALLBACK[item.Name] ~= nil
        or string.find(string.lower(item.Name), "axe", 1, true) ~= nil
        or item.Name == "Chainsaw"
end

local function axeScore(item)
    if not isAxe(item) then
        return -math.huge
    end

    local priority = tonumber(item:GetAttribute("ToolPriority")) or 0
    local resourceDamage = tonumber(item:GetAttribute("WeaponResourceDamage")) or 0
    local entityDamage = tonumber(item:GetAttribute("WeaponDamage")) or 0

    return priority * 1000000
        + resourceDamage * 10000
        + entityDamage * 100
        + (AXE_FALLBACK[item.Name] or 1)
end

local function isSack(item)
    if not item then
        return false
    end

    return SACK_FALLBACK[item.Name] ~= nil
        or string.find(string.lower(item.Name), "sack", 1, true) ~= nil
end

local function sackScore(item)
    if not isSack(item) then
        return -math.huge
    end

    local capacity = tonumber(item:GetAttribute("Capacity")) or 0
    return capacity * 1000 + (SACK_FALLBACK[item.Name] or 1)
end

local function ownedContainers()
    -- Keep this array compact because findBestOwned iterates it with ipairs.
    -- Some executors/games do not expose Inventory, but Backpack/Character
    -- still need to be searched for the best axe and sack.
    local containers = {}
    local inventory = player:FindFirstChild("Inventory")
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character

    if inventory then table.insert(containers, inventory) end
    if backpack then table.insert(containers, backpack) end
    if character then table.insert(containers, character) end

    return containers
end

local function findBestOwned(scoreFunction)
    local best = nil
    local bestScore = -math.huge

    for _, container in ipairs(ownedContainers()) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                local ok, score = pcall(scoreFunction, item)
                if ok and score > bestScore then
                    best = item
                    bestScore = score
                end
            end
        end
    end

    return best, bestScore
end

local function findBestWorld(scoreFunction)
    local items = workspace:FindFirstChild("Items")
    if not items then
        return nil, -math.huge
    end

    local best = nil
    local bestScore = -math.huge

    for _, item in ipairs(items:GetChildren()) do
        local ok, score = pcall(scoreFunction, item)
        if ok and score > bestScore then
            best = item
            bestScore = score
        end
    end

    return best, bestScore
end

local function requestHotbarPickup(item)
    if not item or not item.Parent then
        return false
    end

    if not isLive(RequestHotbarItem) then
        refreshRemotes()
        if not isLive(RequestHotbarItem) then
