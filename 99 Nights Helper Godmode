local previousFarm = {
    chop = false,
    kill = false,
    gear = false,
    walkSpeed = 16,
    jumpPower = 50,
    jumpHeight = 7.2,
    autoRotate = true,
}

local function lockFarmCharacter()
    local humanoid = getHumanoid()
    local root = getRoot()

    if humanoid then
        humanoid.WalkSpeed = 0
        humanoid.AutoRotate = false

        if humanoid.UseJumpPower then
            humanoid.JumpPower = 0
        else
            humanoid.JumpHeight = 0
        end
    end

    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.Anchored = true
    end
end

local function cancelFarmTween()
    if G.SB99_ACTIVE_TWEEN then
        pcall(function()
            G.SB99_ACTIVE_TWEEN:Cancel()
        end)
        G.SB99_ACTIVE_TWEEN = nil
    end
end

local function foodServiceDue()
    return os.clock() - state.lastFoodService >= state.foodInterval
end

local function moveFarmTo(position, ignoreInterrupts)
    if not state.autoFarm then
        return false
    end

    local root = getRoot()
    if not root then
        return false
    end

    lockFarmCharacter()

    local distance = (root.Position - position).Magnitude
    local duration = math.max(0.15, distance / state.patrolSpeed)

    local tween = TweenService:Create(
        root,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(position) }
    )

    G.SB99_ACTIVE_TWEEN = tween
    tween:Play()

    while state.active
        and state.autoFarm
        and tween.PlaybackState == Enum.PlaybackState.Playing do

        if not ignoreInterrupts then
            if state.emergencyFoodRun or foodServiceDue() or isNight() then
                tween:Cancel()
                break
            end
        end

        task.wait(0.1)
    end

    if G.SB99_ACTIVE_TWEEN == tween then
        G.SB99_ACTIVE_TWEEN = nil
    end

    return tween.PlaybackState == Enum.PlaybackState.Completed
end

local function cookItem(item)
    local mainFire = getMainFire()

    if not item or not item.Parent or not mainFire or not RequestCookItem then
        return false
    end

    local ok = pcall(function()
        if RequestCookItem:IsA("RemoteFunction") then
            RequestCookItem:InvokeServer(mainFire, item)
        else
            RequestCookItem:FireServer(mainFire, item)
        end
    end)

    return ok
end

local function runFoodService()
    if not state.autoFarm or state.foodServiceRunning then
        return
    end

    state.foodServiceRunning = true
    state.emergencyFoodRun = false
    cancelFarmTween()

    -- Always stay under center while servicing food.
    local character = getCharacter()
    if character then
        character:PivotTo(CFrame.new(FARM_HOME))
    end
    lockFarmCharacter()

    local items = workspace:FindFirstChild("Items")

    if items then
        local foods = {}

        -- Snapshot before requests can replace/remove raw food.
        for _, item in ipairs(items:GetChildren()) do
            if isFoodItem(item) then
                table.insert(foods, item)
            end
        end

        local index = 0

        for _, item in ipairs(foods) do
            if not state.autoFarm then
                break
            end

            if item and item.Parent then
                index = index + 1

                local column = (index - 1) % 7
                local row = math.floor((index - 1) / 7) % 5

                local offset = Vector3.new(
                    (column - 3) * 1.6,
                    0,
                    (row - 2) * 1.6
                )

                dragItemTo(item, CFrame.new(FOOD_AREA + offset))
                task.wait(0.025)

                if item.Parent and isCookable(item) then
                    cookItem(item)
                    task.wait(0.025)
                end
            end
        end

        -- Give cooked replacements time to appear.
        task.wait(3)

        if (getRealHunger() or state.maxHunger) <= state.eatThreshold then
            attemptAutoEat()
        end
    end

    state.lastFoodService = os.clock()
    state.foodServiceRunning = false
end

local patrolPoints = {}

-- Four rings out to 700 studs. Offset alternating rings so coverage overlaps.
for ring = 1, 4 do
    local radius = ring * 175

    for point = 0, 7 do
        local offsetDegrees = (ring % 2 == 0) and 22.5 or 0
        local angle = math.rad(point * 45 + offsetDegrees)

        table.insert(patrolPoints, Vector3.new(
            math.cos(angle) * radius,
            -50,
            math.sin(angle) * radius
        ))
    end
end

local function enableFarm()
    if state.autoFarm then
        return
    end

    local humanoid = getHumanoid()

    previousFarm.chop = state.autoChop
    previousFarm.kill = state.killAura
    previousFarm.gear = state.autoBestGear

    if humanoid then
        previousFarm.walkSpeed = humanoid.WalkSpeed
        previousFarm.jumpPower = humanoid.JumpPower
        previousFarm.jumpHeight = humanoid.JumpHeight
        previousFarm.autoRotate = humanoid.AutoRotate
    end

    state.autoFarm = true
    state.autoChop = true
    state.killAura = true
    state.autoBestGear = true
    state.patrolIndex = 1

    -- Immediate first food sweep, then every minute.
    state.lastFoodService = 0

    createPlatform()

    local character = getCharacter()
    if character then
        character:PivotTo(CFrame.new(FARM_HOME))
    end

    lockFarmCharacter()
end

local function disableFarm()
    if not state.autoFarm then
        return
    end

    state.autoFarm = false
    state.emergencyFoodRun = false
    state.foodServiceRunning = false

    cancelFarmTween()

    state.autoChop = previousFarm.chop
    state.killAura = previousFarm.kill
    state.autoBestGear = previousFarm.gear

    local humanoid = getHumanoid()
    local root = getRoot()
    local character = getCharacter()

    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    if humanoid then
        humanoid.WalkSpeed = previousFarm.walkSpeed
        humanoid.AutoRotate = previousFarm.autoRotate

        if humanoid.UseJumpPower then
            humanoid.JumpPower = previousFarm.jumpPower
        else
            humanoid.JumpHeight = previousFarm.jumpHeight
        end
    end

    destroyPlatform()

    if character then
        character:PivotTo(CFrame.new(RETURN_POSITION))
    end
end

-- Farm lock. Does not force a position because the Tween controls daytime movement.
track(RunService.Heartbeat:Connect(function()
    if not state.active or not state.autoFarm then
        return
    end

    state.autoChop = true
    state.killAura = true
    state.autoBestGear = true

    if not farmPlatform or not farmPlatform.Parent then
        createPlatform()
    end

    lockFarmCharacter()
end))

-- Main Auto Farm controller.
task.spawn(function()
    local wasNight = false

    while state.active do
        if not state.autoFarm then
            wasNight = false
            task.wait(0.4)
        else
            local night = isNight()

            -- NIGHT: stay directly under center. No roaming.
            if night then
                if not wasNight then
                    cancelFarmTween()
                    local character = getCharacter()
                    if character then
                        character:PivotTo(CFrame.new(FARM_HOME))
                    end
                    lockFarmCharacter()
                end

                wasNight = true

                -- Food is still brought/cooked every minute at night.
                if state.emergencyFoodRun or foodServiceDue() then
                    runFoodService()
                end

                task.wait(0.5)
            else
                wasNight = false

                -- Food service has priority over roaming.
                if state.emergencyFoodRun or foodServiceDue() then
                    moveFarmTo(FARM_HOME, true)
                    runFoodService()
                    task.wait(0.2)
                else
                    local point = patrolPoints[state.patrolIndex]

                    if moveFarmTo(point, false) then
                        state.patrolIndex = state.patrolIndex + 1

                        -- After a complete sweep, return home before starting again.
                        if state.patrolIndex > #patrolPoints then
                            state.patrolIndex = 1
                            moveFarmTo(FARM_HOME, true)
                            task.wait(1)
                        else
                            task.wait(0.3)
                        end
                    else
                        task.wait(0.1)
                    end
                end
            end
        end
    end
end)

