    box.BackgroundColor3 = initialVal and Color3.fromRGB(0, 180, 120) or Color3.fromRGB(36, 36, 46)
    box.Text = initialVal and "✓" or ""
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 12
    box.ZIndex = 103
