local function getRootPart()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 4)
end

local function getInstancePath(instance)
    if not instance or instance == game then return "" end
    local parts = {}
    local curr = instance
    while curr and curr ~= game do
        if curr == workspace then
            table.insert(parts, 1, "workspace")
            break
        elseif curr.Name:match("^[%a_][%w_]*$") then
            table.insert(parts, 1, curr.Name)
        else
            table.insert(parts, 1, '["' .. curr.Name:gsub('"', '\\"') .. '"]')
        end
        curr = curr.Parent
    end
    
    local path = ""
    for i, part in ipairs(parts) do
        if i == 1 then
            path = part
        elseif part:sub(1, 1) == "[" then
            path = path .. part
        else
            path = path .. "." .. part
        end
    end
    return path
end

local function resolvePath(pathStr)
    if not pathStr or pathStr:gsub("%s+", "") == "" then return nil end
    pathStr = pathStr:gsub("^%s+", ""):gsub("%s+$", "")

    if loadstring then
        local ok, res = pcall(function()
            return loadstring("return " .. pathStr)()
        end)
        if ok and typeof(res) == "Instance" then
            return res
        end
    end

    local clean = pathStr:gsub("^game%.Workspace", "workspace")
                         :gsub("^game:GetService%(%\"Workspace\"%)", "workspace")
                         :gsub("^game%.", "")

    local current = (clean:sub(1, 9) == "workspace") and workspace or game
    if clean:sub(1, 9) == "workspace" then
        clean = clean:sub(11)
    end

    local tokens = {}
    local pos = 1
    local len = #clean
    while pos <= len do
        local c = clean:sub(pos, pos)
        if c == "." then
            pos = pos + 1
        elseif c == "[" then
            local quote = clean:sub(pos + 1, pos + 1)
            if quote == '"' or quote == "'" then
                local close = clean:find(quote .. "%]", pos + 2)
                if close then
                    table.insert(tokens, clean:sub(pos + 2, close - 1))
                    pos = close + 2
                else
                    break
                end
            else
                break
            end
        else
            local nextDelim = clean:find("[%.%[]", pos)
            if nextDelim then
                table.insert(tokens, clean:sub(pos, nextDelim - 1))
                pos = nextDelim
            else
                table.insert(tokens, clean:sub(pos))
                break
            end
        end
    end

    for _, token in ipairs(tokens) do
        if token ~= "" then
            current = current:FindFirstChild(token)
            if not current then return nil end
        end
    end
    return current
end

local function teleportTo(inst)
    local root = getRootPart()
    if not root or not inst or not inst.Parent then return false end

    local targetCF = nil
    if inst:IsA("BasePart") then
        targetCF = inst.CFrame
    elseif inst:IsA("Model") then
        targetCF = inst:GetPivot()
    else
        local part = inst:FindFirstChildWhichIsA("BasePart", true)
        if part then targetCF = part.CFrame end
    end

    if targetCF then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = targetCF + Vector3.new(0, heightOffset, 0)
        return true
    end
    return false
end

-- ==============================================================================
-- ADVANCED PROXIMITY RAY-SCANNER (FINDS COINS, TRANSPARENT & CANQUERY=FALSE)
-- ==============================================================================
local function getObjectUnderScreenPoint(screenX, screenY)
    Camera = workspace.CurrentCamera or Camera
    if not Camera then return nil end

    local ray = Camera:ViewportPointToRay(screenX, screenY)
    local maxDistance = 600
    local filter = {LocalPlayer.Character}

    -- 1. Standard Raycast
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = filter
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.RespectCanCollide = false
    local directHit = workspace:Raycast(ray.Origin, ray.Direction * maxDistance, params)
    local endDist = directHit and (directHit.Position - ray.Origin).Magnitude or maxDistance

    -- 2. Proximity check along ray (Solves CanQuery = false coins & transparent hitboxes)
    local bestPart = nil
    local bestProj = endDist
    local searchRadius = 4.5

    local overlap = OverlapParams.new()
    overlap.FilterDescendantsInstances = filter
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.RespectCanCollide = false

    local step = 10
    local steps = math.min(math.floor(endDist / step), 20)

    for i = 1, steps do
        local point = ray.Origin + ray.Direction * (i * step)
        local nearby = workspace:GetPartBoundsInRadius(point, searchRadius, overlap)
        for _, part in ipairs(nearby) do
            if part:IsA("BasePart") and not part:IsDescendantOf(LocalPlayer.Character) then
                local toPart = part.Position - ray.Origin
                local proj = toPart:Dot(ray.Direction)
                if proj > 1 and proj < bestProj then
                    local perpDist = (toPart - ray.Direction * proj).Magnitude
                    local allowed = math.max(3.0, part.Size.Magnitude * 0.6)
                    if perpDist <= allowed then
                        bestProj = proj
                        bestPart = part
                    end
                end
            end
        end
    end

    if bestPart then
        return bestPart
    end

    if directHit and directHit.Instance then
        return directHit.Instance
    end

    -- 3. Fallback mouse target
    local mouse = LocalPlayer:GetMouse()
    if mouse and mouse.Target and not mouse.Target:IsDescendantOf(LocalPlayer.Character) then
        return mouse.Target
    end

    return nil
end

