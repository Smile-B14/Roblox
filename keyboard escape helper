    VisualBox.Adornee = nil
    TargetTag.Enabled = false
    TargetTag.Adornee = nil
end

local function applyVisuals(targetInstance, displayName)
    clearVisuals()
    if not targetInstance then return end

    local partToAdorn = nil
    if targetInstance:IsA("BasePart") then
        partToAdorn = targetInstance
    elseif targetInstance:IsA("Model") then
        partToAdorn = targetInstance.PrimaryPart or targetInstance:FindFirstChildWhichIsA("BasePart", true)
        VisualHighlight.Adornee = targetInstance
    elseif targetInstance:IsA("Folder") then
        -- Folders cannot be directly adorned; find first descendant part for visual representation
        partToAdorn = targetInstance:FindFirstChildWhichIsA("BasePart", true)
    end

    if partToAdorn then
        VisualBox.Adornee = partToAdorn
        TargetTag.Adornee = partToAdorn
        TagLabel.Text = displayName or targetInstance.Name
        TargetTag.Enabled = true
        if not VisualHighlight.Adornee and (partToAdorn:IsA("BasePart") or partToAdorn:IsA("Model")) then
            VisualHighlight.Adornee = partToAdorn
        end
    end
end

