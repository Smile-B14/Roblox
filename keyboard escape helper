    txt.Font = Enum.Font.Gotham
    txt.TextSize = 11
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.ZIndex = 103
    txt.Parent = frame

    local state = initialVal
    local function toggle()
        state = not state
        box.Text = state and "✓" or ""
        box.BackgroundColor3 = state and Color3.fromRGB(0, 180, 120) or Color3.fromRGB(36, 36, 46)
        callback(state)
    end

    box.MouseButton1Click:Connect(toggle)
    local clickArea = Instance.new("TextButton")
    clickArea.Size = UDim2.new(1, 0, 1, 0)
    clickArea.BackgroundTransparency = 1
    clickArea.Text = ""
    clickArea.ZIndex = 103
    clickArea.Active = true
    clickArea.Parent = frame
    clickArea.MouseButton1Click:Connect(toggle)
end

