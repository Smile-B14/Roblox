-- ==============================================================================
-- TELEPORT & QUEUE COLLECTOR ENGINE
-- ==============================================================================
local function stopTeleporting()
    isRunning = false
    if loopThread then
        task.cancel(loopThread)
        loopThread = nil
    end
    if childAddedConnection then
        childAddedConnection:Disconnect()
        childAddedConnection = nil
    end
    ToggleTPBtn.Text = "▶ START TELEPORT"
    ToggleTPBtn.BackgroundColor3 = Color3.fromRGB(35, 160, 85)
    StatusLabel.Text = "Status: Idle"
    StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
end

local function startTeleporting()
    local target = resolvePath(PathBox.Text)
    if not target then
        StatusLabel.Text = "Error: Invalid Path or Target"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
        return
    end

    isRunning = true
    applyVisuals(target, target.Name)
    ToggleTPBtn.Text = "⏹ STOP TELEPORT"
    ToggleTPBtn.BackgroundColor3 = Color3.fromRGB(190, 45, 45)
    StatusLabel.TextColor3 = Color3.fromRGB(0, 240, 255)

    loopThread = task.spawn(function()
        local isContainer = target:IsA("Folder") or (target:IsA("Model") and #target:GetChildren() > 0 and not target:FindFirstChildWhichIsA("Humanoid"))

        if isContainer then
            local queue = {}
            local queuedSet = {}

            local function pushChild(child)
                if (child:IsA("BasePart") or child:IsA("Model")) and not queuedSet[child] then
                    queuedSet[child] = true
                    table.insert(queue, child)
                end
            end

            for _, child in ipairs(target:GetChildren()) do
                pushChild(child)
            end

            childAddedConnection = target.ChildAdded:Connect(function(newChild)
                pushChild(newChild)
                StatusLabel.Text = "New spawn! (" .. #queue .. " in queue)"
            end)

            while isRunning do
                if #queue > 0 then
                    local item = table.remove(queue, 1)
                    queuedSet[item] = nil

                    if item and item.Parent and target:IsAncestorOf(item) then
                        StatusLabel.Text = "Collecting: " .. item.Name .. " (" .. #queue .. " left)"
                        teleportTo(item)
                        task.wait(tpDelay)
                    end
                else
                    if loopFolderItems then
                        local curChildren = target:GetChildren()
                        if #curChildren > 0 then
                            for _, child in ipairs(curChildren) do
                                pushChild(child)
                            end
                        end
                        task.wait(0.1)
                    else
                        StatusLabel.Text = "Waiting for new spawns in folder..."
                        task.wait(0.3)
                    end
                end
            end
        else
            while isRunning do
                if target and target.Parent then
                    StatusLabel.Text = "Locking to: " .. target.Name
                    teleportTo(target)
                else
                    stopTeleporting()
                    StatusLabel.Text = "Target removed/destroyed!"
                    break
                end
                task.wait(tpDelay)
            end
        end
    end)
end

ToggleTPBtn.MouseButton1Click:Connect(function()
    if isRunning then
        stopTeleporting()
    else
        startTeleporting()
    end
end)

