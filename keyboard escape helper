-- Main Picker Touch / Click Handler
PickerOverlay.InputBegan:Connect(function(input)
    local isTouch = (input.UserInputType == Enum.UserInputType.Touch)
    local isClick = (input.UserInputType == Enum.UserInputType.MouseButton1)

    if not isTouch and not isClick then return end

    local x = input.Position.X
    local y = input.Position.Y

    local hitPart = getObjectUnderScreenPoint(x, y)
    if hitPart then
        local chosenTarget = hitPart
        local labelText = hitPart.Name

        if autoSelectFolder and hitPart.Parent and hitPart.Parent ~= workspace and (hitPart.Parent:IsA("Folder") or hitPart.Parent:IsA("Model")) then
            chosenTarget = hitPart.Parent
            labelText = "📁 " .. chosenTarget.Name
            StatusLabel.Text = "Selected Folder: " .. chosenTarget.Name
        else
            labelText = "🎯 " .. chosenTarget.Name
            StatusLabel.Text = "Selected: " .. chosenTarget.Name
        end

        PathBox.Text = getInstancePath(chosenTarget)
        applyVisuals(chosenTarget, labelText)
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 170)
        closePicker()
    else
        StatusLabel.Text = "No object detected. Try tapping closer!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end)

