local function trim(value)
    return tostring(value or ""):match("^%s*(.-)%s*$") or ""
end

local function isFiniteNumber(value)
    return type(value) == "number"
        and value == value
        and value ~= math.huge
        and value ~= -math.huge
        and math.abs(value) <= 10000000
end

local function formatNumber(value)
    if math.abs(value) >= 10000 then
        return string.format("%.0f", value)
    end
    return string.format("%.1f", value)
end

local function formatCoordinates(cframeData)
    if type(cframeData) ~= "table" then
        return "Invalid position"
    end
    return string.format(
        "X %s   Y %s   Z %s",
        formatNumber(tonumber(cframeData[1]) or 0),
        formatNumber(tonumber(cframeData[2]) or 0),
        formatNumber(tonumber(cframeData[3]) or 0)
    )
end

local function generateId()
    local ok, result = pcall(function()
        return HttpService:GenerateGUID(false)
    end)
    if ok then
        return result
    end
    return tostring(os.clock()) .. "_" .. tostring(math.random(100000, 999999))
end

local function cframeToTable(cframe)
    return {cframe:GetComponents()}
end

local function tableToCFrame(data)
    if type(data) ~= "table" or #data ~= 12 then
        return nil
    end

    local clean = {}
    for index = 1, 12 do
        local value = tonumber(data[index])
        if not isFiniteNumber(value) then
            return nil
        end
        clean[index] = value
    end

    local ok, result = pcall(function()
        return CFrame.new(unpackValues(clean))
    end)
    return ok and result or nil
end

local function getRootPart()
    local character = LocalPlayer.Character
    if not character then
        return nil, nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
        or character.PrimaryPart

    if humanoid and humanoid.Health <= 0 then
        return nil, humanoid
    end
    return root, humanoid
end

local function findPosition(id)
    for index, position in ipairs(positions) do
        if position.id == id then
            return position, index
        end
    end
    return nil, nil
end

local function cleanPositionName(name)
    name = trim(name):gsub("[%c]", "")
    if #name > 28 then
        name = name:sub(1, 28)
    end
    return name
end

local function makeUniqueName(requestedName, ignoredId)
    local base = cleanPositionName(requestedName)
    if base == "" then
        base = "Position " .. tostring(#positions + 1)
    end

    local function exists(candidate)
        for _, position in ipairs(positions) do
            if position.id ~= ignoredId and position.name:lower() == candidate:lower() then
                return true
            end
        end
        return false
    end

    if not exists(base) then
        return base
    end

    local suffix = 2
    while exists(base .. " (" .. suffix .. ")") do
        suffix = suffix + 1
    end
    return base .. " (" .. suffix .. ")"
end

local function loadPositions()
    if not storageAvailable then
        return
    end

    local ok, decoded = pcall(function()
        if not isfile(FILE_NAME) then
            return nil
        end
        return HttpService:JSONDecode(readfile(FILE_NAME))
    end)

    if not ok or type(decoded) ~= "table" then
        return
    end

    local source = type(decoded.positions) == "table" and decoded.positions or decoded
    for _, item in ipairs(source) do
        if #positions >= MAX_POSITIONS then
            break
        end

        if type(item) == "table" and tableToCFrame(item.cframe) then
            table.insert(positions, {
                id = type(item.id) == "string" and item.id or generateId(),
                name = makeUniqueName(item.name),
                cframe = item.cframe,
            })
        end
    end
end

local function savePositions()
    if not storageAvailable then
        return false, "File saving is not available in this executor session."
    end

    local ok, message = pcall(function()
        local payload = {
            version = 1,
            positions = positions,
        }
        writefile(FILE_NAME, HttpService:JSONEncode(payload))
    end)

    if not ok then
        storageAvailable = false
        return false, tostring(message)
    end
    return true
end

