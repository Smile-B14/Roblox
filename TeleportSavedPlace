            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            ZIndex = 52,
        })
        nextY = nextY + 32
    end

    local inputs = {}
    for _, field in ipairs(options.fields or {}) do
        local box = create("TextBox", {
            Parent = Card,
            Position = UDim2.fromOffset(16, nextY),
            Size = UDim2.new(1, -32, 0, 40),
            BackgroundColor3 = Theme.Surface3,
            BorderSizePixel = 0,
            PlaceholderText = field.placeholder or field.label or "",
            PlaceholderColor3 = Theme.Muted,
            Text = tostring(field.value or ""),
            TextColor3 = Theme.Text,
            TextSize = 12,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false,
            ZIndex = 52,
        })
        addCorner(box, 9)
        addStroke(box, Theme.Border, 0.25, 1)
        create("UIPadding", {
            Parent = box,
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 10),
        })
        inputs[field.key] = box
        nextY = nextY + 50
    end

    local ErrorLabel = create("TextLabel", {
        Parent = Card,
        Position = UDim2.new(0, 16, 1, -73),
        Size = UDim2.new(1, -32, 0, 18),
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = Theme.Red,
        TextSize = 10,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 52,
    })

    local Cancel = create("TextButton", {
        Parent = Card,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 16, 1, -14),
        Size = UDim2.new(0.5, -21, 0, 38),
        BackgroundColor3 = Theme.Surface3,
        BorderSizePixel = 0,
        Text = "CANCEL",
        TextColor3 = Theme.Muted,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        ZIndex = 52,
    })
    addCorner(Cancel, 9)

    local Confirm = create("TextButton", {
        Parent = Card,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -16, 1, -14),
        Size = UDim2.new(0.5, -21, 0, 38),
        BackgroundColor3 = options.danger and Color3.fromRGB(106, 42, 54) or Theme.Accent,
        BorderSizePixel = 0,
        Text = options.confirmText or "SAVE",
        TextColor3 = options.danger and Theme.Red or Theme.Text,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        ZIndex = 52,
    })
    addCorner(Confirm, 9)

    connect(Cancel.Activated, closeModal)
    connect(Confirm.Activated, function()
        local values = {}
        for key, box in pairs(inputs) do
            values[key] = box.Text
