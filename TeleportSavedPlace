local function teleportTo(position)
    if not position then
        notify("Select a position first.", "warning")
        return
    end

    local destination = tableToCFrame(position.cframe)
    if not destination then
        notify("This saved position is invalid.", "error")
        return
    end

    local root, humanoid = getRootPart()
    local character = LocalPlayer.Character
    if not root or not character then
        notify("Your character is not ready yet.", "error")
        return
    end

    if humanoid then
        humanoid.Sit = false
    end

    local ok = pcall(function()
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        if type(character.PivotTo) == "function" then
            character:PivotTo(destination)
        else
            root.CFrame = destination
        end
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)

    if ok then
        notify("Teleported to " .. position.name, "success")
    else
        notify("Teleport failed in this game.", "error")
    end
end

local function commitChanges(successMessage)
    local saved, saveError = savePositions()
    updateHeader()
    updateSelection()
    refreshList()

    if saved then
        notify(successMessage, "success")
    elseif storageAvailable then
        notify(successMessage, "success")
    else
        notify(successMessage .. " (session only)", saveError and "warning" or "success")
    end
end

local function addPosition(name, cframe)
    if #positions >= MAX_POSITIONS then
        notify("The 100-position limit has been reached.", "error")
        return false
    end

    local position = {
        id = generateId(),
        name = makeUniqueName(name),
        cframe = cframeToTable(cframe),
    }
    table.insert(positions, position)
    selectedId = position.id
    NameInput.Text = ""
    commitChanges("Saved " .. position.name)
    return true
end

