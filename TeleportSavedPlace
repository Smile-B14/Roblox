            ErrorLabel.Text = tostring(errorMessage or "Please check the values.")
            return
        end
        closeModal()
    end)

    if options.fields and options.fields[1] and inputs[options.fields[1].key] then
        task.defer(function()
            if inputs[options.fields[1].key].Parent then
                inputs[options.fields[1].key]:CaptureFocus()
            end
        end)
    end
