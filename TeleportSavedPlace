        local root = getRootPart()
        if root then
            SelectedCoordinates.Text = string.format(
                "Current: X %s  Y %s  Z %s",
                formatNumber(root.Position.X),
                formatNumber(root.Position.Y),
                formatNumber(root.Position.Z)
            )
        else
