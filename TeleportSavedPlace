local function notify(message, kind)
    toastSequence = toastSequence + 1
    local thisSequence = toastSequence
    local color = Theme.Accent
    if kind == "success" then
        color = Theme.Green
    elseif kind == "error" then
        color = Theme.Red
    elseif kind == "warning" then
        color = Theme.Yellow
    end

    ToastText.Text = tostring(message)
    ToastDot.BackgroundColor3 = color
    ToastStroke.Color = color
    Toast.Visible = true
    Toast.Position = UDim2.new(0.5, 0, 0, -60)
    tween(Toast, 0.25, {Position = UDim2.new(0.5, 0, 0, 18)})

    task.delay(2.8, function()
        if destroyed or thisSequence ~= toastSequence then
            return
        end
        local animation = tween(Toast, 0.22, {Position = UDim2.new(0.5, 0, 0, -60)})
        animation.Completed:Wait()
        if thisSequence == toastSequence then
            Toast.Visible = false
        end
    end)
end

