connect(AddCoordinatesButton.Activated, function()
    local root = getRootPart()
    local current = root and root.Position or Vector3.new(0, 0, 0)
    openModal({
        title = "ADD COORDINATES",
        description = "The current facing direction will be kept when possible.",
        fields = {
            {key = "name", placeholder = "Position name", value = NameInput.Text},
            {key = "x", placeholder = "X coordinate", value = formatNumber(current.X)},
            {key = "y", placeholder = "Y coordinate", value = formatNumber(current.Y)},
            {key = "z", placeholder = "Z coordinate", value = formatNumber(current.Z)},
        },
        confirmText = "ADD POSITION",
        onConfirm = function(values)
            local x, y, z = tonumber(values.x), tonumber(values.y), tonumber(values.z)
            if not isFiniteNumber(x) or not isFiniteNumber(y) or not isFiniteNumber(z) then
                return false, "X, Y, and Z must be valid numbers."
            end

            local orientation = CFrame.new()
            local currentRoot = getRootPart()
            if currentRoot then
                orientation = currentRoot.CFrame - currentRoot.Position
            end
            return addPosition(values.name, CFrame.new(x, y, z) * orientation)
        end,
    })
end)

