local function keepOnScreen(guiObject)
    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local viewport = camera.ViewportSize
    local absolutePosition = guiObject.AbsolutePosition
    local absoluteSize = guiObject.AbsoluteSize
    local moveX, moveY = 0, 0
    local margin = 8

    if absolutePosition.X < margin then
        moveX = margin - absolutePosition.X
    elseif absolutePosition.X + absoluteSize.X > viewport.X - margin then
        moveX = (viewport.X - margin) - (absolutePosition.X + absoluteSize.X)
    end

    if absolutePosition.Y < margin then
        moveY = margin - absolutePosition.Y
    elseif absolutePosition.Y + absoluteSize.Y > viewport.Y - margin then
        moveY = (viewport.Y - margin) - (absolutePosition.Y + absoluteSize.Y)
    end

    if moveX ~= 0 or moveY ~= 0 then
        guiObject.Position = UDim2.new(
            guiObject.Position.X.Scale,
            guiObject.Position.X.Offset + moveX,
            guiObject.Position.Y.Scale,
            guiObject.Position.Y.Offset + moveY
        )
    end
end

local function makeDraggable(handle, target)
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPosition = nil

    connect(handle.InputBegan, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        dragging = true
        dragStart = input.Position
        startPosition = target.Position

        connect(input.Changed, function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                keepOnScreen(target)
            end
        end)
    end)

    connect(handle.InputChanged, function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    connect(UserInputService.InputChanged, function(input)
        if not dragging or input ~= dragInput or not dragStart or not startPosition then
            return
        end
        local delta = input.Position - dragStart
        target.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)
end

