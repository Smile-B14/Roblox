local FAR = CFrame.new(0, 100000, 100000)

local function groundedCFrame(model, desired)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	params.FilterDescendantsInstances = {state.display, player.Character}
	local origin = desired.Position + Vector3.new(0, 25, 0)
	local hit = workspace:Raycast(origin, Vector3.new(0, -100, 0), params)
	if not hit then return desired end
	local pivot = model:GetPivot()
	local box, size = model:GetBoundingBox()
	local footOffset = pivot.Position.Y - (box.Position.Y - size.Y * 0.5)
	local position = Vector3.new(desired.Position.X, hit.Position.Y + footOffset, desired.Position.Z)
	return CFrame.fromMatrix(position, desired.XVector, desired.YVector, desired.ZVector)
end

local function walkFacingCFrame(position, direction)
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 0.001 then flat = Vector3.new(0, 0, -1) end
	-- The road controller uses movement yaw directly. The +90° offset is display-only.
	return CFrame.lookAt(position, position + flat.Unit)
end

local function getLocalBaseDestination()
	local ok, plot = pcall(PlotController.GetMyPlot, PlotController)
	if not ok or not plot or not plot.PlotModel then return nil end
	local plotModel = plot.PlotModel
	local delivery = plotModel:FindFirstChild("DeliveryHitbox") or plotModel:FindFirstChild("Entrance", true)
	local podiums = plotModel:FindFirstChild("AnimalPodiums")
	local animalList = plot.Channel and plot.Channel:Get("AnimalList") or {}
	local emptyPodium
	if podiums then
		local children = podiums:GetChildren()
		table.sort(children, function(a,b) return (tonumber(a.Name) or math.huge) < (tonumber(b.Name) or math.huge) end)
		for _, podium in ipairs(children) do
			local index = tonumber(podium.Name) or podium.Name
			local entry = animalList[index] or animalList[tostring(index)]
			local spawn = podium:FindFirstChild("Base") and podium.Base:FindFirstChild("Spawn")
			if spawn and (entry == nil or entry == "Empty") and not podium:GetAttribute("DeferDisplay") then emptyPodium = podium; break end
		end
	end
	return {plot=plot, model=plotModel, delivery=delivery, podium=emptyPodium}
end

local function simulateLocalPodium(model, name, podium, token)
	local spawn = podium and podium:FindFirstChild("Base") and podium.Base:FindFirstChild("Spawn")
	if not (spawn and model.Parent) then return false end
	model:PivotTo(spawn:GetPivot())
	local idleFolder = AnimalAnimations:FindFirstChild(name)
	local idle = idleFolder and (idleFolder:FindFirstChild("Idle") or idleFolder:FindFirstChild("RoadBrainrotIdle"))
	local animator = model:FindFirstChildWhichIsA("Animator", true)
	if animator and idle then local ok, track=pcall(function() return animator:LoadAnimation(idle) end); if ok and track then track.Looped=true; track:Play(0.1); state.tracks[#state.tracks+1]=track end end
	local trove = Trove.new(); state.troves[#state.troves+1]=trove
	local generation = type(AnimalsData[name] and AnimalsData[name].Generation)=="number" and AnimalsData[name].Generation or 0
	if name:find("Lucky Block",1,true) then generation=0 end
	local startedAt = os.clock()
	local claim = podium:FindFirstChild("Claim") and podium.Claim:FindFirstChild("Main")
	if claim and claim:IsA("BasePart") then
		local ok = pcall(function()
		local cashGui, removeCash = FastOverheadController.createFastOverhead({adornee=claim, guiTemplate=FastOverheadController.GuiTemplates.CashPad})
		trove:Add(removeCash)
		local collect = VirtualInstance.wrap(cashGui.Collect)
		local collectAmount = VirtualInstance.wrap(cashGui.CollectAmount)
		local offline = VirtualInstance.wrap(cashGui.Offline); offline.Visible=false
		local collectedAt=os.clock()
		local wasInside=false
		trove:Add(task.spawn(function()
			while model.Parent and token==state.token do
				collectAmount.Text=("$%s"):format(NumberUtils:ToString(math.floor(os.clock()-collectedAt)*generation)); collect.Visible=true
				local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				local inside=root and (Vector3.new(root.Position.X,claim.Position.Y,root.Position.Z)-claim.Position).Magnitude <= math.max(claim.Size.X,claim.Size.Z)*0.65
				if inside and not wasInside then collectedAt=os.clock(); collectAmount.Text="$0"; SoundController:PlaySound("Sounds.Sfx.Success") end
				wasInside=inside and true or false
				task.wait(0.1)
			end
		end))
		end)
		if not ok then warn("[RNG Visualizer] Native local cash pad could not be created") end
	end
	local attachment=spawn:FindFirstChild("PromptAttachment")
	if not attachment then attachment=Instance.new("Attachment"); attachment.Name="PromptAttachment"; attachment.Parent=spawn; trove:Add(attachment) end
	if not AnimalPrompt then return true end
	-- Empty podium prompts already occupy E/F locally. Disable and restore them so the
	-- visual Brainrot's authentic prompts are not suppressed by OnePerButton exclusivity.
	for _, existing in ipairs(attachment:GetChildren()) do
		if existing:IsA("ProximityPrompt") then local old=existing.Enabled; existing.Enabled=false; trove:Add(function() if existing.Parent then existing.Enabled=old end end) end
	end
	local grab=AnimalPrompt.new(podium.Name,name,attachment,{Exclusivity=Enum.ProximityPromptExclusivity.AlwaysShow})
	local sell=AnimalPrompt.new(podium.Name,name,attachment,{KeyboardKeyCode=Enum.KeyCode.F,GamepadKeyCode=Enum.KeyCode.ButtonY,UIOffset=Vector2.new(0,-72),Exclusivity=Enum.ProximityPromptExclusivity.AlwaysShow})
	trove:Add(function() grab:Destroy(); sell:Destroy() end)
	local grabbed=false
	grab:SetState("Grab",function()
		if not model.Parent then return end
		SoundController:PlaySound("Sounds.Sfx.Activated")
		grabbed=not grabbed; grab:SetState(grabbed and "Place" or "Grab")
		if grabbed then
			trove:Add(game:GetService("RunService").RenderStepped:Connect(function() local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart"); if grabbed and root and model.Parent then model:PivotTo(root.CFrame*CFrame.new(0,0,-4)) end end))
		else model:PivotTo(spawn:GetPivot()) end
	end)
	sell:SetState("Sell",function() SoundController:PlaySound("Sounds.Sfx.Activated"); safeDestroy(model); trove:Destroy() end)
	return true
end

local function walkPurchasedModel(model, name, token)
	local destination = getLocalBaseDestination()
	local target = destination and (destination.delivery or (destination.podium and destination.podium.Base.Spawn))
	if not (target and target:IsA("BasePart")) then warn("[RNG Visualizer] Local base destination is not streamed in; keeping purchased Brainrot at the machine"); return end
	local animationFolder = AnimalAnimations:FindFirstChild(name)
	local walkAnimation = animationFolder and animationFolder:FindFirstChild("Walk")
	local animator = model:FindFirstChildWhichIsA("Animator", true)
	for _, active in ipairs(animator and animator:GetPlayingAnimationTracks() or {}) do active:AdjustWeight(0.001,0.1) end
	if animator and walkAnimation and walkAnimation:IsA("Animation") then
		local ok, track = pcall(function() return animator:LoadAnimation(walkAnimation) end)
		if ok and track then track.Looped = true; track.Priority=Enum.AnimationPriority.Movement; track:Play(0.1,1,1); track:AdjustWeight(1,0.1); track:AdjustSpeed((walkAnimation:GetAttribute("Speed") or 1)*0.75); state.tracks[#state.tracks + 1] = track end
	end
	local start = model:GetPivot()
	local finishPosition = target.Position
	local direction = Vector3.new(finishPosition.X - start.Position.X, 0, finishPosition.Z - start.Position.Z)
	local finish = walkFacingCFrame(finishPosition, direction.Magnitude > 0.01 and direction or start.LookVector)
	local driver = Instance.new("CFrameValue"); driver.Value = start; driver.Parent = state.display
	local connection = driver.Changed:Connect(function(value) if token == state.token and model.Parent then model:PivotTo(groundedCFrame(model, value)) end end)
	state.connections[#state.connections + 1] = connection
	local duration = math.clamp((finishPosition - start.Position).Magnitude / 12, 2, 8)
	local tween = TweenService:Create(driver, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Value = finish})
	state.tweens[#state.tweens + 1] = tween; tween:Play(); tween.Completed:Wait()
	connection:Disconnect(); safeDestroy(driver)
	if token~=state.token or not model.Parent then return end
	if destination.podium then
		local ok, placed = pcall(simulateLocalPodium,model,name,destination.podium,token)
		if ok and placed then return end
		warn("[RNG Visualizer] Podium presentation failed; keeping Brainrot at delivery")
	end
	-- A full base has no native empty slot. Keep the local result waiting at delivery.
	model:PivotTo(groundedCFrame(model, target:GetPivot() * CFrame.new(0,0,-3)))
end

local function addNativeOverhead(model, name, lifetime)
	local data = AnimalsData[name]
	local primary = model.PrimaryPart
	if not (data and primary) or data.HideOverhead then return nil end
	local trove = Trove.new()
	state.troves[#state.troves + 1] = trove
	local attachment = model:FindFirstChild("OVERHEAD_ATTACHMENT", true)
	if not (attachment and attachment:IsA("Attachment")) then
		attachment = Instance.new("Attachment")
		attachment.Name = "RNGMachineOverhead"
		attachment.Parent = primary
		attachment.WorldCFrame = model:GetPivot() * CFrame.new(0, model:GetExtentsSize().Y * 0.75 * (data.OverheadYOffsetModifier or 1), 0)
		trove:Add(attachment)
	end
	local overhead, removeOverhead = FastOverheadController.createFastOverhead({
		adornee = attachment,
		guiTemplate = FastOverheadController.GuiTemplates.AnimalOverhead,
	})
	trove:Add(removeOverhead)
	AnimalOverheadController:Populate({HidePrice=true, Overhead=overhead, Index=name, Player=player, Trove=trove})
	if overhead:FindFirstChild("Generation") then
		local generation = data.Generation
		if name:find("Lucky Block", 1, true) then generation = 0 end
		overhead.Generation.Text = ("$%*/s"):format(NumberUtils:ToString(type(generation) == "number" and generation or 0))
		overhead.Generation.Visible = not data.HideGeneration
	end
	local timerLabel = overhead:FindFirstChild("Stolen")
	if timerLabel and timerLabel:IsA("TextLabel") then
		timerLabel.Visible = true; timerLabel.LayoutOrder = -1; timerLabel.Size = UDim2.fromScale(1, 0.25)
		local expires = os.clock() + lifetime
		trove:Add(task.spawn(function()
			while model.Parent and os.clock() < expires do
				timerLabel.Text = ("%ds"):format(math.max(0, math.ceil(expires - os.clock())))
				task.wait(0.1)
			end
			if timerLabel.Parent then timerLabel.Text = "0s" end
		end))
	end
	model.Destroying:Once(function() pcall(function() trove:Destroy() end) end)
	return overhead, timerLabel
end

