		SideBarWidth = 150,
		HideSearchBar = false,
		ScrollBarEnabled = true,
		User = {Enabled = false},
	})
	state.windWindow = Window
	local MainTab = Window:Tab({Title = "Machine", Icon = "sparkles"})

	local Setup = MainTab:Section({Title = "RNG Machine Setup", Box = true, Opened = true})
	local resultSource, selectedMachine, selectedFun = "Machine", brainrotNames[1], nil
	Setup:Dropdown({
		Title = "Result source",
		Desc = "Explicitly choose which Brainrot list is active",
		Values = {"Machine", "Fun only"}, Value = "Machine", Multi = false, AllowNone = false,
		Callback = function(value)
			resultSource = value
			state.brainrot = value == "Fun only" and (selectedFun or selectedMachine) or selectedMachine
		end,
	})
	table.clear(state.sequence)
	if luckNames[1] then state.sequence[1] = luckNames[1] end
	refreshSequence()
	Setup:Dropdown({
		Title = "Target luck",
		Desc = "Earlier luck tiers are added automatically",
		Values = luckNames,
		Value = luckNames[1],
		Multi = false,
		AllowNone = false,
		Callback = function(value)
			table.clear(state.sequence)
			local target = luckNumber(value)
			for _, luck in ipairs(luckNames) do
				if (luckNumber(luck) or math.huge) <= (target or 0) then state.sequence[#state.sequence + 1] = luck end
			end
			refreshSequence()
		end,
	})
	local machineDisplay, machineLookup = {}, {}
	for _, name in ipairs(brainrotNames) do
		local display = ("%s  •  %s%%"):format((AnimalsData[name] and AnimalsData[name].DisplayName) or name, tostring(machineChance[name] or "?"))
		machineDisplay[#machineDisplay + 1] = display; machineLookup[display] = name
	end
	Setup:Dropdown({
		Title = "Machine Brainrot",
		Desc = "Verified RNG Machine result",
		Values = machineDisplay,
		Value = machineDisplay[1],
		Multi = false,
		AllowNone = false,
		Callback = function(value)
			selectedMachine = machineLookup[value] or selectedMachine
			if resultSource == "Machine" then state.brainrot = selectedMachine end
		end,
	})
	local machineSet = {}; for _, name in ipairs(brainrotNames) do machineSet[name] = true end
	local otherDisplay, otherLookup = {}, {}
	for name, data in pairs(AnimalsData) do
		if type(name) == "string" and type(data) == "table" and not machineSet[name] and data.DisplayName then
			local display = "🔴 " .. tostring(data.DisplayName)
			-- Preserve duplicate display names without inventing a different model key.
			if otherLookup[display] then display = display .. "  [" .. name .. "]" end
			otherDisplay[#otherDisplay + 1] = display; otherLookup[display] = name
		end
	end
	table.sort(otherDisplay, function(a, b) return a:lower() < b:lower() end)
	local Other = MainTab:Section({Title = "🔴 OTHER BRAINROTS — FUN ONLY", Box = true, Opened = true})
	Other:Paragraph({
		Title = "Not obtainable from the RNG Machine",
		Desc = "These are shown in red and are available only for local visualization.",
		Color = "Red",
	})
	Other:Dropdown({
		Title = "All other Brainrots",
		Desc = ("%d live Animals entries"):format(#otherDisplay),
		Values = otherDisplay,
		Multi = false,
		AllowNone = true,
		Callback = function(value)
			local name = otherLookup[value]
			if name then selectedFun=name; if resultSource=="Fun only" then state.brainrot=name end; WindUI:Notify({Title="Fun result selected", Content=((AnimalsData[name] and AnimalsData[name].DisplayName) or name).." is not an RNG Machine result. Switch Result source to Fun only to activate it.", Duration=3, Icon="triangle-alert"}) end
		end,
	})
	local Controls = MainTab:Section({Title = "Machine Trigger", Box = true, Opened = true})
	Controls:Toggle({
		Title = "Arm RNG Machine",
		Desc = "Enabled: the machine Spin prompt plays your selected local sequence",
		Value = false,
		Callback = function(enabled)
			if enabled then
				if not state.armed then armMachine() end
				if not state.armed then WindUI:Notify({Title="Could not arm", Content="Move near the RNG Machine and try again.", Duration=3, Icon="triangle-alert"}) end
			else
				stopVisuals()
				if state.armed then disarmMachine() end
			end
		end,
	})
	Controls:Paragraph({Title = "Visual only", Desc = "Choose one target luck and one Brainrot, enable Arm, then use the machine.", Color = "Green"})
	Window:SelectTab(1)
else
	gui.Enabled = true
	warn("[RNG Visualizer] WindUI could not load; using compact fallback UI.")
end

print(("[RNG Visualizer] Loaded %d luck models and %d RNG-machine Brainrots. No remotes are used."):format(#luckNames,#brainrotNames))
LoaderRunning=false
safeDestroy(LoaderGui)
