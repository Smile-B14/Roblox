local function trackConnection(c)
	state.connections[#state.connections + 1] = c
	return c
end

local function own(instance)
	state.instances[#state.instances + 1] = instance
	return instance
end

local function safeDestroy(instance)
	if instance then pcall(function() instance:Destroy() end) end
end

local function stopVisuals()
	state.playing = false
	state.token += 1
	for _, tween in ipairs(state.tweens) do pcall(function() tween:Cancel() end) end
	table.clear(state.tweens)
	for _, track in ipairs(state.tracks) do pcall(function() track:Stop(0.1) end) end
	table.clear(state.tracks)
	for _, sound in ipairs(state.sounds) do safeDestroy(sound) end
	table.clear(state.sounds)
	for _, trove in ipairs(state.troves) do pcall(function() trove:Destroy() end) end
	table.clear(state.troves)
	for object, properties in pairs(state.vfxSnapshots) do
		if object.Parent then for property, value in pairs(properties) do pcall(function() object[property] = value end) end end
	end
	table.clear(state.vfxSnapshots)
	for _, clone in ipairs(state.vfxClones) do safeDestroy(clone) end
	table.clear(state.vfxClones)
	if state.display then safeDestroy(state.display); state.display = nil end
	if state.oldSpinningText then
		local s = state.oldSpinningText
		if s.label and s.label.Parent then
			s.label.Text = s.text
			s.label.Visible = s.visible
			s.label.TextXAlignment = s.alignment
		end
		if s.image and s.image.Parent and s.imageValue then s.image.Image = s.imageValue end
		state.oldSpinningText = nil
	end
end

local function disarmMachine()
	state.armed = false
	if state.fakePrompt then safeDestroy(state.fakePrompt); state.fakePrompt = nil end
	if state.realPrompt and state.realPrompt.Parent and state.realPromptWasEnabled ~= nil then
		state.realPrompt.Enabled = state.realPromptWasEnabled
	end
	state.realPrompt, state.realPromptWasEnabled = nil, nil
end

local function cleanup()
	if state.dead then return end
	state.dead = true
	stopVisuals()
	disarmMachine()
	if state.windWindow then pcall(function() state.windWindow:Destroy() end); state.windWindow = nil end
	for _, c in ipairs(state.connections) do pcall(function() c:Disconnect() end) end
	for _, instance in ipairs(state.instances) do safeDestroy(instance) end
	table.clear(state.connections)
	table.clear(state.instances)
	if env[KEY] == state then env[KEY] = nil end
end
state.Cleanup = cleanup

