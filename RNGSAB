local function animateResult(kind, name, stage, token)
	local center = getCenter()
	if not center then return false, "RNGMachineCenter tag was not found" end
	if not state.display then
		state.display = Instance.new("Folder")
		state.display.Name = "SAB_RNGMachineVisualizerDisplay"
		state.display.Parent = workspace.CurrentCamera or workspace
	end
	local entries = {}
	local desiredIndex = 7
	for i = 1, 10 do
		local candidate
		if i == desiredIndex then
			candidate = kind == "Luck" and cloneLuck(name) or cloneBrainrot(name)
		else
			local fallback = brainrotNames[((i * 17 + stage - 2) % math.max(1, #brainrotNames)) + 1]
			candidate = fallback and cloneBrainrot(fallback)
		end
		if candidate then candidate.Parent = state.display; candidate:PivotTo(FAR); entries[i] = candidate end
	end
	if not entries[desiredIndex] then return false, "Could not load display model: " .. tostring(name) end
	playLever()
	local spinner = Instance.new("NumberValue")
	spinner.Name = "Spinner"
	spinner.Parent = state.display
	local lastTick, lastIndex = 0, -1
	-- Slightly quicker than the inspected game's default, without feeling rushed.
	local duration = math.max(2.2, 3.05 - (stage - 1) * 0.08)
	local rotations = 7 * 10 + desiredIndex
	local connection = spinner.Changed:Connect(function(value)
		if token ~= state.token or not state.playing then return end
		local pivot = center:GetPivot()
		for i, model in pairs(entries) do
			if model.Parent then
				local phase = math.clamp((value - (i - 1)) % 10 * 0.5, 0, 1)
				local arc = math.sin(phase * math.pi)
				if arc < 0.01 then model:PivotTo(FAR) else
					local baseScale = model:GetAttribute("SABVisualizerScale") or model:GetScale()
					model:ScaleTo(math.max(0.001, baseScale * arc))
					local desired = pivot * CFrame.new(arc * -5 + 5, 0, (phase - 0.5) * 20) * CFrame.Angles(0, math.pi / 2, 0)
					model:PivotTo(groundedCFrame(model, desired))
				end
			end
		end
		local current = (math.floor(value + 0.5) - 1) % 10 + 1
		if current ~= lastIndex and os.clock() - lastTick >= 0.1 then
			lastIndex, lastTick = current, os.clock()
			playSound(stage == 1 and "RegularSpin" or "LuckySpin", center, math.min((stage - 1) * 0.08 + 1, 1.4), stage <= 1 and 1 or math.min((stage - 2) * 0.12 + 1.12, 1.8))
		end
	end)
	state.connections[#state.connections + 1] = connection
	local tween = TweenService:Create(spinner, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Value = rotations})
	state.tweens[#state.tweens + 1] = tween
	tween:Play()
	tween.Completed:Wait()
	if token ~= state.token or not state.playing then return false end
	connection:Disconnect()
	spinner:Destroy()
	local winner = entries[desiredIndex]
	for i, model in pairs(entries) do if i ~= desiredIndex then safeDestroy(model) end end
	winner:ScaleTo(winner:GetAttribute("SABVisualizerScale") or winner:GetScale())
	winner:PivotTo(groundedCFrame(winner, center:GetPivot() * CFrame.Angles(0, math.pi / 2, 0)))
	if kind == "Luck" then
		local amount = luckNumber(name) or 1
		playSound("LuckLanded", center, math.min((stage - 1) * 0.08 + 1, 1.4), math.min((stage - 1) * 0.12 + 1.2, 1.8))
		flash(winner, amount)
		setLuckyMachineVfx(amount, true)
		emitLuckEffects(amount)
	else
		setLuckyMachineVfx(1, false)
		playSound("BrainrotLanded", center, math.min((stage - 1) * 0.08 + 1, 1.4), math.min((stage - 2) * 0.12 + 1.12, 1.8))
		addLocalPurchasePrompt(winner, name, token)
	end
	return true
end

