local function modelBasePart(model)
	return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

local function prepareModel(model, targetSize)
	local primary = model.PrimaryPart
	-- Cloned game assets can retain CollectionService tags. Remove them so unrelated
	-- gameplay/anti-cheat observers never treat these camera-only visuals as live animals.
	for _, tagged in ipairs(model:GetDescendants()) do
		for _, tag in ipairs(CollectionService:GetTags(tagged)) do CollectionService:RemoveTag(tagged, tag) end
	end
	for _, tag in ipairs(CollectionService:GetTags(model)) do CollectionService:RemoveTag(model, tag) end
	for _, object in ipairs(model:GetDescendants()) do
		if object:IsA("BasePart") then
			object.Anchored = false
			object.CanCollide = false
			object.CanQuery = false
			object.CanTouch = false
			object.Massless = true
			if not primary then model.PrimaryPart = object; primary = object end
		elseif object:IsA("LuaSourceContainer") then
			object:Destroy()
		end
	end
	if primary then primary.Anchored = true end
	if targetSize then
		local _, size = model:GetBoundingBox()
		local largest = math.max(size.X, size.Y, size.Z)
		if largest > 0 then model:ScaleTo(model:GetScale() * targetSize / largest) end
	end
	model:SetAttribute("SABVisualizerScale", model:GetScale())
	return model
end

local function playIdle(model, name)
	local folder = AnimalAnimations:FindFirstChild(name)
	local animation = folder and (folder:FindFirstChild("RoadBrainrotIdle") or folder:FindFirstChild("Idle"))
	if not (animation and animation:IsA("Animation")) then return end
	local controller = model:FindFirstChildOfClass("AnimationController") or model:FindFirstChildOfClass("Humanoid")
	if not controller then controller = Instance.new("AnimationController"); controller.Parent = model end
	local animator = controller:FindFirstChildOfClass("Animator") or Instance.new("Animator", controller)
	local ok, result = pcall(function() return animator:LoadAnimation(animation) end)
	if ok and result then
		result.Priority = Enum.AnimationPriority.Idle
		result.Looped = true
		result:Play(0.1)
		result:AdjustSpeed(animation:GetAttribute("Speed") or 1)
		state.tracks[#state.tracks + 1] = result
	end
end

local function cloneLuck(name)
	local number = luckNumber(name)
	local source = LuckIcons:FindFirstChild(tostring(number)) or LuckIcons:FindFirstChild(tostring(number) .. "x")
	if not (source and source:IsA("Model")) then return nil end
	return prepareModel(source:Clone())
end

local function cloneBrainrot(name)
	local source
	pcall(function() source = BrainrotAssets.getModel(name) end)
	if not (source and source:IsA("Model")) then pcall(function() source = BrainrotAssets.getModelBestEffort(name, nil, 1) end) end
	if not (source and source:IsA("Model")) then return nil end
	local clone = prepareModel(source:Clone())
	-- Native RNGMachineController removes spin trails/emitters from Brainrot displays.
	-- Without this, moving a cached model from FAR to the machine can draw lines from the sky.
	for _, effect in ipairs(clone:GetDescendants()) do
		if effect:IsA("Trail") or effect:IsA("ParticleEmitter") then
			effect:Destroy()
		elseif effect:IsA("Beam") then
			effect.Enabled = false
		end
	end
	playIdle(clone, name)
	return clone
end

local function playSound(name, parent, speed, volumeBoost)
	local source = Sounds:FindFirstChild(name)
	if not (source and source:IsA("Sound")) then return end
	local sound = source:Clone()
	local attributeId = sound:GetAttribute("SoundId")
	if type(attributeId) == "string" then sound:SetAttribute("SoundId", nil); sound.SoundId = attributeId end
	sound.Looped = false
	sound.PlaybackSpeed = speed or 1
	sound.Volume *= volumeBoost or 1
	sound.Parent = parent
	state.sounds[#state.sounds + 1] = sound
	sound.Ended:Once(function() safeDestroy(sound) end)
	sound:Play()
	return sound
end

local function flash(model, luck)
	local part = modelBasePart(model)
	if not part then return end
	local glow = LuckIcons:FindFirstChild(tostring(luck))
	local emitter = glow and glow:FindFirstChild("Glow", true)
	local color = emitter and emitter:IsA("ParticleEmitter") and emitter.Color.Keypoints[1].Value or Color3.fromRGB(72, 255, 108)
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness, light.Shadows = color, 24, 0, true
	light.Parent = part
	local highlight = Instance.new("Highlight")
	highlight.Adornee, highlight.FillColor, highlight.OutlineColor = model, color, color
	highlight.FillTransparency, highlight.OutlineTransparency = 1, 1
	highlight.Parent = model
	local a = TweenService:Create(light, TweenInfo.new(0.12), {Brightness = 8})
	local b = TweenService:Create(highlight, TweenInfo.new(0.12), {FillTransparency = 0.2, OutlineTransparency = 0})
	a:Play(); b:Play()
	task.delay(0.45, function() safeDestroy(light); safeDestroy(highlight) end)
end

local function remember(object, property)
	local snapshot = state.vfxSnapshots[object]
	if not snapshot then snapshot = {}; state.vfxSnapshots[object] = snapshot end
	if snapshot[property] == nil then pcall(function() snapshot[property] = object[property] end) end
end

local function getLuckStyle(amount)
	local iconModel = LuckIcons:FindFirstChild(tostring(amount))
	local glow = iconModel and iconModel:FindFirstChild("Glow", true)
	if glow and glow:IsA("ParticleEmitter") then
		return glow.Color, glow.Color.Keypoints[1].Value, LuckIconData[("%sx"):format(amount)]
	end
	return nil, nil, LuckIconData[("%sx"):format(amount)]
end

local function styleVfx(root, sequence, color, texture)
	for _, object in ipairs(root:GetDescendants()) do
		local iconEffect = object.Name == "LuckIcons" or object.Name == "LuckIcon"
		if object:IsA("ParticleEmitter") or object:IsA("Beam") or object:IsA("Trail") then
			if iconEffect and texture then remember(object, "Texture"); object.Texture = texture
			elseif sequence then remember(object, "Color"); object.Color = sequence end
		elseif object:IsA("Light") and color then remember(object, "Color"); object.Color = color end
	end
end

local function restoreMachineVfx()
	for object, properties in pairs(state.vfxSnapshots) do
		if object.Parent then for property, value in pairs(properties) do pcall(function() object[property] = value end) end end
	end
	table.clear(state.vfxSnapshots)
end

local function setLuckyMachineVfx(amount, enabled)
	if not enabled then restoreMachineVfx(); return end
	local sequence, color, texture = getLuckStyle(amount)
	for _, tag in ipairs({"RNGMachineRecolorVFX", "RNGMachinePadVFX"}) do
		for _, root in ipairs(CollectionService:GetTagged(tag)) do
			if root:IsDescendantOf(workspace) then
				if root:IsA("BasePart") and color and tag == "RNGMachineRecolorVFX" then remember(root, "Color"); root.Color = color end
				styleVfx(root, sequence, color, texture)
				for _, object in ipairs(root:GetDescendants()) do
					if object:IsA("ParticleEmitter") or object:IsA("Beam") or object:IsA("Trail") then remember(object, "Enabled") end
				end
				pcall(VFX.enable, root, true)
			end
		end
	end
end

local function emitLuckEffects(amount)
	local sequence, color, texture = getLuckStyle(amount)
	local tag = amount >= 12 and "RNGMachine12xExplosionVFX" or (amount >= 10 and "RNGMachine10xExplosionVFX" or "RNGMachineLuckExplosionVFX")
	for _, root in ipairs(CollectionService:GetTagged(tag)) do
		if root:IsDescendantOf(workspace) then styleVfx(root, sequence, color, texture); pcall(VFX.emit, root) end
	end
	if amount == 10 or amount == 12 then
		local library = ReplicatedStorage:FindFirstChild("RNGMachineVFX")
		local source = library and library:FindFirstChild(("%sxLuckMapVFX"):format(amount))
		if source then
			local clone = own(source:Clone())
			state.vfxClones[#state.vfxClones + 1] = clone
			clone.Name = "SAB_LocalLuckMapVFX"
			clone.Parent = workspace
			styleVfx(clone, sequence, color, texture)
			pcall(VFX.emit, clone)
			task.delay(10, function() safeDestroy(clone) end)
		end
	end
end

