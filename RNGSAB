local function startSequence()
	if state.playing then return end
	if not getCenter() then status.Text="Move near the RNG Machine (center not streamed in)"; return end
	if #state.sequence==0 and not state.brainrot then status.Text="Choose at least one result"; return end
	stopVisuals(); state.playing=true; state.token+=1; local token=state.token
	task.spawn(function()
		setMachineText(player.DisplayName.." is spinning...")
		local stage=1
		for _, luck in ipairs(state.sequence) do
			if token~=state.token then return end
			status.Text=("Stage %d — landing %s"):format(stage,luck)
			local ok,err=animateResult("Luck",luck,stage,token)
			if not ok then if err then status.Text=err end; stopVisuals(); return end
			task.wait(); if state.display then safeDestroy(state.display); state.display=nil end; stage+=1
		end
		if state.brainrot and token==state.token then
			status.Text=("Final stage — landing %s"):format(state.brainrot)
			local ok,err=animateResult("Brainrot",state.brainrot,stage,token)
			if not ok then if err then status.Text=err end; stopVisuals(); return end
		end
		if token==state.token then state.playing=false; status.Text="Complete — press STOP / RESET to restore" end
	end)
end

