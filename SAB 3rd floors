-- 2. საქაღალდეების მომზადება
local existingFolder = Workspace:FindFirstChild(CONFIG.FOLDER_NAME)
if existingFolder then
    existingFolder:Destroy()
end

local mainFolder = Instance.new("Folder")
mainFolder.Name = CONFIG.FOLDER_NAME
mainFolder.Parent = Workspace

local mainPlatformsFolder = Instance.new("Folder")
mainPlatformsFolder.Name = CONFIG.MAIN_FOLDER_NAME
mainPlatformsFolder.Parent = mainFolder

local smallPlatformsFolder = Instance.new("Folder")
smallPlatformsFolder.Name = CONFIG.SMALL_FOLDER_NAME
smallPlatformsFolder.Parent = mainFolder

-- 3. უნივერსალური ფუნქცია
local function createPlatform(config)
    local part = Instance.new("Part")
    part.Name = config.name
    part.Size = config.size
    part.Position = config.position
    part.Anchored = true
    part.CanCollide = true
    part.Material = Enum.Material.SmoothPlastic
    part.Color = config.color

    local surfaceGui = Instance.new("SurfaceGui")
    surfaceGui.Face = Enum.NormalId.Top
    surfaceGui.AlwaysOnTop = false
    surfaceGui.LightInfluence = 0
    surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
    surfaceGui.CanvasSize = config.canvasSize
    surfaceGui.Parent = part

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(0.9, 0, 0.9, 0)
    textLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    textLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = config.text
    textLabel.TextColor3 = CONFIG.TEXT_COLOR
    textLabel.TextScaled = true
    textLabel.Font = CONFIG.TEXT_FONT
    textLabel.Rotation = config.rotation
    textLabel.Parent = surfaceGui

    part.Parent = config.parentFolder
end

-- 4. დიდი პლატფორმების შექმნა ("Smile B")
for i, base in ipairs(MAIN_BASES) do
    local minX = math.min(base.c1.X, base.c2.X)
    local maxX = math.max(base.c1.X, base.c2.X)
    local minZ = math.min(base.c1.Z, base.c2.Z)
    local maxZ = math.max(base.c1.Z, base.c2.Z)

    local centerX = (minX + maxX) / 2
    local centerZ = (minZ + maxZ) / 2
    local position = Vector3.new(centerX + CONFIG.MAIN_OFFSET.X, CONFIG.MAIN_ROOF_Y, centerZ + CONFIG.MAIN_OFFSET.Z)

    createPlatform({
        name = "RoofPlatform_" .. i,
        size = CONFIG.MAIN_ROOF_SIZE,
        position = position,
        color = CONFIG.MAIN_COLOR,
        rotation = (centerX < -400) and 0 or 180,
        parentFolder = mainPlatformsFolder,
        canvasSize = CONFIG.MAIN_CANVAS,
        text = CONFIG.MAIN_TEXT
    })
end

-- 5. მცირე პლატფორმების შექმნა ("SMB")
for i, base in ipairs(SMALL_BASES) do
    local minX = math.min(base.c1.X, base.c2.X)
    local maxX = math.max(base.c1.X, base.c2.X)
    local minY = math.min(base.c1.Y, base.c2.Y)
    local maxY = math.max(base.c1.Y, base.c2.Y)
    local minZ = math.min(base.c1.Z, base.c2.Z)
    local maxZ = math.max(base.c1.Z, base.c2.Z)

    local size = Vector3.new(5, 0.3, maxZ - minZ)
    local rawCenterX = (minX + maxX) / 2
    local xShift = (rawCenterX < -400) and 4 or -4
    local center = Vector3.new(rawCenterX + xShift, ((minY + maxY) / 2) + 0.1, (minZ + maxZ) / 2)

    createPlatform({
        name = "SmallPlatform_" .. i,
        size = size,
        position = center,
        color = CONFIG.SMALL_COLOR,
        rotation = (rawCenterX < -400) and 0 or 180,
        parentFolder = smallPlatformsFolder,
        canvasSize = CONFIG.SMALL_CANVAS,
        text = CONFIG.SMALL_TEXT
    })
end
