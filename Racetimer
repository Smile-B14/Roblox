TrackConnection(RunService.Heartbeat:Connect(function()
	if App.Destroyed or SetupActive or not ActiveCourse then
		return
	end

	local character = LocalPlayer.Character
	local root = character and (
		character:FindFirstChild("HumanoidRootPart")
		or character.PrimaryPart
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
	)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or (humanoid and humanoid.Health <= 0) then
		PreviousRootPosition = nil
		return
	end

	local currentPosition = root.Position
	local startHit, startDistance = SampleGate(ActiveCourse[1], ActiveCourse[2], PreviousRootPosition, currentPosition)
	local finishHit, finishDistance = SampleGate(ActiveCourse[3], ActiveCourse[4], PreviousRootPosition, currentPosition)
	local startedThisFrame = false

	if not StartArmed and startDistance > CONFIG.ReleaseDistance then
		StartArmed = true
	end
	if not FinishArmed and finishDistance > CONFIG.ReleaseDistance then
		FinishArmed = true
	end

	if StartArmed and startHit then
		StartArmed = false
		if not IsRacing then
			StartRace()
			startedThisFrame = true
		end
	end

	if FinishArmed and finishHit then
		FinishArmed = false
		if IsRacing and not startedThisFrame then
			FinishRace()
		end
	end

	PreviousRootPosition = currentPosition
end))

