local ToastSerial = 0
local function ShowToast(message, color, duration)
	ToastSerial = ToastSerial + 1
	local serial = ToastSerial
	Toast.Text = message
	Toast.TextColor3 = color or COLORS.Text
	Toast.Visible = true
	task.delay(duration or 2.4, function()
		if not App.Destroyed and ToastSerial == serial then
			Toast.Visible = false
		end
	end)
end

local function UpdateResponsiveScale()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local mainValue = math.clamp(math.min((viewport.X - 18) / 420, (viewport.Y - 90) / 500), 0.68, 1)
	local compactValue = math.clamp((viewport.X - 18) / 420, 0.72, 1)
	MainScale.Scale = mainValue
	PlacementScale.Scale = compactValue
	HudScale.Scale = math.clamp((viewport.X - 18) / 340, 0.76, 1)
	ToastScale.Scale = compactValue
end

local CameraViewportConnection = nil
local function BindCameraScale()
	if CameraViewportConnection then
		CameraViewportConnection:Disconnect()
		CameraViewportConnection = nil
	end
	local camera = Workspace.CurrentCamera
	if camera then
		CameraViewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateResponsiveScale)
	end
	UpdateResponsiveScale()
end

TrackConnection(Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(BindCameraScale))
BindCameraScale()

local function MakeDraggable(frame, handle)
	local dragging = false
	local dragInput = nil
	local dragStart = nil
	local startPosition = nil

	TrackConnection(handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		dragging = true
		dragStart = input.Position
		startPosition = frame.Position
		local endConnection
		endConnection = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				if endConnection then
					endConnection:Disconnect()
				end
			end
		end)
	end))

	TrackConnection(handle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end))

	TrackConnection(UserInputService.InputChanged:Connect(function(input)
		if not dragging or input ~= dragInput or not dragStart or not startPosition then
			return
		end
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)

		local camera = Workspace.CurrentCamera
		if camera then
			local viewport = camera.ViewportSize
			local absolutePosition = frame.AbsolutePosition
			local absoluteSize = frame.AbsoluteSize
			local correctionX = 0
			local correctionY = 0
			if absolutePosition.X < 4 then
				correctionX = 4 - absolutePosition.X
			elseif absolutePosition.X + absoluteSize.X > viewport.X - 4 then
				correctionX = (viewport.X - 4) - (absolutePosition.X + absoluteSize.X)
			end
			if absolutePosition.Y < 4 then
				correctionY = 4 - absolutePosition.Y
			elseif absolutePosition.Y + absoluteSize.Y > viewport.Y - 4 then
				correctionY = (viewport.Y - 4) - (absolutePosition.Y + absoluteSize.Y)
			end
			if correctionX ~= 0 or correctionY ~= 0 then
				frame.Position = UDim2.new(
					frame.Position.X.Scale,
					frame.Position.X.Offset + correctionX,
					frame.Position.Y.Scale,
					frame.Position.Y.Offset + correctionY
				)
			end
		end
	end))
end

