local function ExecutorFunction(name)
	local value = nil
	pcall(function()
		value = GlobalEnvironment[name]
	end)
	if type(value) == "function" then
		return value
	end
	pcall(function()
		value = _G[name]
	end)
	return type(value) == "function" and value or nil
end

local FileApi = {
	isfile = ExecutorFunction("isfile"),
	readfile = ExecutorFunction("readfile"),
	writefile = ExecutorFunction("writefile"),
	makefolder = ExecutorFunction("makefolder"),
	isfolder = ExecutorFunction("isfolder"),
	setclipboard = ExecutorFunction("setclipboard") or ExecutorFunction("toclipboard"),
}
FileApi.Available = FileApi.readfile ~= nil and FileApi.writefile ~= nil

local SavePath = CONFIG.FallbackSaveFile
if FileApi.Available and FileApi.makefolder then
	local folderReady = false
	if FileApi.isfolder then
		local ok, exists = pcall(FileApi.isfolder, CONFIG.SaveDirectory)
		folderReady = ok and exists == true
	end
	if not folderReady then
		local makeOk = pcall(FileApi.makefolder, CONFIG.SaveDirectory)
		if not FileApi.isfolder then
			folderReady = makeOk
		end
	end
	if FileApi.isfolder then
		local ok, exists = pcall(FileApi.isfolder, CONFIG.SaveDirectory)
		folderReady = ok and exists == true
	end
	if folderReady then
		SavePath = CONFIG.SaveFile
	end
end

local Database = {
	version = 3,
	bests = {},
	lastCodes = {},
	names = {},
	settings = {
		visuals = true,
		ignoreY = true,
	},
}

local function LoadDatabase()
	if not FileApi.Available then
		return false, "Session-only PB (file API unavailable)"
	end

	local ok, raw = pcall(function()
		if FileApi.isfile and not FileApi.isfile(SavePath) then
			return nil
		end
		return FileApi.readfile(SavePath)
	end)
	if not ok or not raw or raw == "" then
		-- A missing file may throw on executors that do not provide isfile.
		-- writefile is still usable, so this is a clean first run rather than session-only mode.
		return true, "PB saving ready"
	end

	local decodedOk, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	if not decodedOk or type(decoded) ~= "table" then
		return false, "Save file was invalid; using a clean session"
	end

	if type(decoded.bests) == "table" then
		Database.bests = decoded.bests
	end
	if type(decoded.lastCodes) == "table" then
		Database.lastCodes = decoded.lastCodes
	end
	if type(decoded.names) == "table" then
		Database.names = decoded.names
	end
	if type(decoded.settings) == "table" then
		if type(decoded.settings.visuals) == "boolean" then
			Database.settings.visuals = decoded.settings.visuals
		end
		if type(decoded.settings.ignoreY) == "boolean" then
			Database.settings.ignoreY = decoded.settings.ignoreY
		end
	end

	return true, "PB saving ready"
end

local function SaveDatabase()
	if not FileApi.Available then
		return false
	end
	Database.version = 3
	local encodedOk, encoded = pcall(HttpService.JSONEncode, HttpService, Database)
	if not encodedOk then
		return false
	end
	local writeOk = pcall(FileApi.writefile, SavePath, encoded)
	return writeOk
end

