local function PlaceSetupPoint(position)
	if not SetupActive or not position then
		ShowToast("Aim at a solid surface first.", COLORS.Red)
		return
	end

	local nextIndex = #SetupPoints + 1
	if nextIndex > 4 then
		return
	end

	if nextIndex == 2 or nextIndex == 4 then
		local origin = SetupPoints[#SetupPoints]
		position = select(1, GetSnappedPosition(origin, position))
		local width = (Vector2.new(position.X, position.Z) - Vector2.new(origin.X, origin.Z)).Magnitude
		if width < CONFIG.MinimumGateWidth then
			ShowToast("Gate is too short. Place this endpoint at least 3 studs away.", COLORS.Red, 3)
			return
		end
	end

	table.insert(SetupPoints, position)
	RemovePreview()
	RebuildWorldVisuals()

	if #SetupPoints == 4 then
		local completedPoints = SetupPoints
		local courseName = CourseNameBox.Text
		LoadCourse(completedPoints, courseName)
		CopyCourseCode()
		return
	end

	RefreshPlacementInstruction()
end

