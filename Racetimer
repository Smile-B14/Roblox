local function StopAsDnf(reason)
	if not IsRacing then
		return
	end
	FrozenElapsed = math.max(0, os.clock() - RaceStartedAt)
	IsRacing = false
	TimerLabel.Text = FormatTime(FrozenElapsed)
	TimerLabel.TextColor3 = COLORS.Red
	DeltaLabel.Text = "DNF"
	DeltaLabel.TextColor3 = COLORS.Red
	SetHudState(reason or "DNF", COLORS.Red)
end

local function FinishRace()
	if not IsRacing then
		return
	end
	local finalTime = math.max(0, os.clock() - RaceStartedAt)
	if finalTime < CONFIG.MinimumRaceTime then
		return
	end

	IsRacing = false
	FrozenElapsed = finalTime
	TimerLabel.Text = FormatTime(finalTime)
	local previousBest = BestTime
	local isNewBest = finalTime < previousBest

	local entry = Database.bests[ActiveCourseKey]
	if type(entry) ~= "table" then
		entry = {}
	end
	entry.attempts = math.max(0, tonumber(entry.attempts) or 0) + 1
	entry.last = finalTime
	entry.updated = os.time()

	if isNewBest then
		BestTime = finalTime
		entry.best = finalTime
		TimerLabel.TextColor3 = COLORS.Accent
		if previousBest < math.huge then
			DeltaLabel.Text = string.format("-%0.3f", previousBest - finalTime)
		else
			DeltaLabel.Text = "NEW PB"
		end
		DeltaLabel.TextColor3 = COLORS.Accent
		SetHudState("NEW PB", COLORS.Accent)
		ShowToast("New personal best: " .. FormatTime(finalTime), COLORS.Accent, 3)
	else
		TimerLabel.TextColor3 = COLORS.White
		DeltaLabel.Text = string.format("+%0.3f", finalTime - previousBest)
		DeltaLabel.TextColor3 = COLORS.Red
		SetHudState("FINISHED", COLORS.White)
	end

	Database.bests[ActiveCourseKey] = entry
	RefreshBestLabel()
	if not SaveDatabase() and FileApi.Available then
		ShowToast("Finished, but the PB file could not be written.", COLORS.Gold, 3)
	end
end

