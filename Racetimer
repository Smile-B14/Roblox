		return
	end
	local aimPoint = GetAimPoint()
	if not aimPoint then
		RemovePreview()
		return
	end
	local snappedPoint, snapped = GetSnappedPosition(SetupPoints[count], aimPoint)
	UpdatePreview(SetupPoints[count], snappedPoint, snapped)
end))

local function PointerIsOverPlacementControls(position)
	local ok, objects = pcall(function()
		return PlayerGui:GetGuiObjectsAtPosition(position.X, position.Y)
	end)
	if not ok or type(objects) ~= "table" then
		return false
	end
	for _, object in ipairs(objects) do
		if object == PlacementBar or object:IsDescendantOf(PlacementBar) then
			return true
		end
	end
	return false
end

TrackConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not SetupActive then
		return
	end
	if input.KeyCode == Enum.KeyCode.Escape then
		CancelSetup()
		return
	end
	if gameProcessed then
		return
	end
	if input.KeyCode == Enum.KeyCode.E then
		PlaceSetupPoint(GetAimPoint())
	elseif input.KeyCode == Enum.KeyCode.U or input.KeyCode == Enum.KeyCode.Backspace then
		UndoSetupPoint()
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 and not PointerIsOverPlacementControls(input.Position) then
		PlaceSetupPoint(GetScreenPoint(input.Position))
	end
	-- Touch deliberately uses PLACE AIM to avoid accidental points while moving the camera.
end))

