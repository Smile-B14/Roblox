local function GetSnappedPosition(origin, position)
	local differenceX = math.abs(origin.X - position.X)
	local differenceZ = math.abs(origin.Z - position.Z)
	if differenceX <= CONFIG.SnapThreshold or differenceZ <= CONFIG.SnapThreshold then
		if differenceX <= differenceZ then
			return Vector3.new(origin.X, position.Y, position.Z), true
		end
		return Vector3.new(position.X, position.Y, origin.Z), true
	end
	return position, false
end

local function RaycastFromRay(ray)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclusions = {WorldFolder}
	if LocalPlayer.Character then
		table.insert(exclusions, LocalPlayer.Character)
	end
	params.FilterDescendantsInstances = exclusions
	params.IgnoreWater = false
	local result = Workspace:Raycast(ray.Origin, ray.Direction * CONFIG.RayDistance, params)
	return result and result.Position or nil
end

