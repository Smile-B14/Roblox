function App:Destroy()
	if self.Destroyed then
		return
	end
	self.Destroyed = true
	ToastSerial = ToastSerial + 1
	if CurrentDeathConnection then
		CurrentDeathConnection:Disconnect()
		CurrentDeathConnection = nil
	end
	if CameraViewportConnection then
		CameraViewportConnection:Disconnect()
		CameraViewportConnection = nil
	end
	for _, connection in ipairs(self.Connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(self.Connections)
	if WorldFolder and WorldFolder.Parent then
		WorldFolder:Destroy()
	end
	if ScreenGui and ScreenGui.Parent then
		ScreenGui:Destroy()
	end
	if GlobalEnvironment[GLOBAL_KEY] == self then
		GlobalEnvironment[GLOBAL_KEY] = nil
	end
end

