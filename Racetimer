local function PointSegmentDistance(point, endpointA, endpointB)
	local segment = endpointB - endpointA
	local lengthSquared = segment:Dot(segment)
	if lengthSquared <= 0.000001 then
		return (point - endpointA).Magnitude
	end
	local alpha = math.clamp((point - endpointA):Dot(segment) / lengthSquared, 0, 1)
	return (point - (endpointA + segment * alpha)).Magnitude
end

local function Cross2(vectorA, vectorB)
	return vectorA.X * vectorB.Y - vectorA.Y * vectorB.X
end

local function SegmentIntersection(movementA, movementB, gateA, gateB)
	local movement = movementB - movementA
	local gate = gateB - gateA
	local denominator = Cross2(movement, gate)
	if math.abs(denominator) < 0.000001 then
		return nil
	end
	local difference = gateA - movementA
	local movementAlpha = Cross2(difference, gate) / denominator
	local gateAlpha = Cross2(difference, movement) / denominator
	if movementAlpha >= 0 and movementAlpha <= 1 and gateAlpha >= 0 and gateAlpha <= 1 then
		return movementAlpha
	end
	return nil
end

local function HeightAllowed(gatePointA, gatePointB, yPosition)
	if Database.settings.ignoreY then
		return true
	end
	local middleY = (gatePointA.Y + gatePointB.Y) / 2
	return math.abs(yPosition - middleY) <= CONFIG.VerticalTolerance
end

local function SampleGate(pointA, pointB, previousPosition, currentPosition)
	local gateA2 = Vector2.new(pointA.X, pointA.Z)
	local gateB2 = Vector2.new(pointB.X, pointB.Z)
	local current2 = Vector2.new(currentPosition.X, currentPosition.Z)
	local distance = PointSegmentDistance(current2, gateA2, gateB2)

	if distance <= CONFIG.TriggerThickness / 2 and HeightAllowed(pointA, pointB, currentPosition.Y) then
		return true, distance
	end

	if previousPosition then
		local previous2 = Vector2.new(previousPosition.X, previousPosition.Z)
		local movementDistance = (current2 - previous2).Magnitude
		if movementDistance > 0.001 and movementDistance <= CONFIG.MaximumCrossingStep then
			local alpha = SegmentIntersection(previous2, current2, gateA2, gateB2)
			if alpha then
				local crossingY = previousPosition.Y + (currentPosition.Y - previousPosition.Y) * alpha
				if HeightAllowed(pointA, pointB, crossingY) then
					return true, distance
				end
			end
		end
	end

	return false, distance
end

local function StartRace()
	if not ActiveCourse or IsRacing then
		return
	end
	IsRacing = true
	RaceStartedAt = os.clock()
	FrozenElapsed = 0
