local function FormatTime(seconds)
	seconds = math.max(0, tonumber(seconds) or 0)
	local totalMilliseconds = math.floor(seconds * 1000 + 0.5)
	local milliseconds = totalMilliseconds % 1000
	local totalSeconds = math.floor(totalMilliseconds / 1000)
	local secs = totalSeconds % 60
	local totalMinutes = math.floor(totalSeconds / 60)
	if totalMinutes >= 60 then
		local hours = math.floor(totalMinutes / 60)
		local minutes = totalMinutes % 60
		return string.format("%02d:%02d:%02d.%03d", hours, minutes, secs, milliseconds)
	end
	return string.format("%02d:%02d.%03d", totalMinutes, secs, milliseconds)
end

local function Trim(text)
	return (tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function IsFiniteNumber(value)
	return type(value) == "number" and value == value and value > -10000000 and value < 10000000
end

local function ParseVector(segment)
	local values = string.split(Trim(segment), ",")
	if #values ~= 3 then
		return nil
	end
	local x = tonumber(Trim(values[1]))
	local y = tonumber(Trim(values[2]))
	local z = tonumber(Trim(values[3]))
	if not IsFiniteNumber(x) or not IsFiniteNumber(y) or not IsFiniteNumber(z) then
		return nil
	end
	return Vector3.new(x, y, z)
end

local function SerializePoints(points)
	local segments = {"SBR3"}
	for index = 1, 4 do
		local point = points[index]
		table.insert(segments, string.format("%.3f,%.3f,%.3f", point.X, point.Y, point.Z))
	end
	return table.concat(segments, "|")
end

local function ParseCode(code)
	code = Trim(code)
	if code == "" then
		return nil, "Paste a course code first."
	end

	local segments = string.split(code, "|")
	local offset = 0
	if string.upper(Trim(segments[1] or "")) == "SBR3" then
		offset = 1
	end
	if #segments - offset ~= 4 then
		return nil, "Invalid code: expected exactly four points."
	end

	local points = {}
	for index = 1, 4 do
		local point = ParseVector(segments[index + offset])
		if not point then
			return nil, "Invalid coordinate in point " .. tostring(index) .. "."
		end
		points[index] = point
	end

	local startWidth = (Vector2.new(points[2].X, points[2].Z) - Vector2.new(points[1].X, points[1].Z)).Magnitude
	local finishWidth = (Vector2.new(points[4].X, points[4].Z) - Vector2.new(points[3].X, points[3].Z)).Magnitude
	if startWidth < CONFIG.MinimumGateWidth then
		return nil, "Start gate is too short. Endpoints must be at least 3 studs apart."
	end
	if finishWidth < CONFIG.MinimumGateWidth then
		return nil, "Finish gate is too short. Endpoints must be at least 3 studs apart."
	end

	return points, nil
end

