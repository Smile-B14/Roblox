-- Ground & 360 Spiral Runner with Human-like Smooth Slerp/Lerp Rotation
local function executeHumanWalk(targetPos, isSpiral)
    if not hrp or not hrp.Parent or not humanoid then return false end

    local dynamicSpeed = BASE_SPEED + math.random(-3, 3) + math.sin(tick() * 3) * 2
    humanoid.WalkSpeed = dynamicSpeed

    if runTrack and not runTrack.IsPlaying then
        runTrack:Play(0.15)
        runTrack:AdjustSpeed(1.45)
    end

    local startPos = hrp.Position
    local delta = targetPos - startPos
    local dist = delta.Magnitude
    if dist < 0.2 then return true end

    local reached = false
    local startTime = tick()
    local maxDuration = math.max(dist / BASE_SPEED + 0.8, 1.4)
    local threshold = isSpiral and 4.8 or 3.8

    while isFarming and not reached do
        local curPos = hrp.Position
        local d = targetPos - curPos
        local curDist = d.Magnitude

        if curDist > 0.1 then
            local forward = d / curDist
            local targetCFrame

            if isSpiral then
                -- Cylindrical normal calculation: Center of loop is (X=1286, Y=407)
                local toCenter = Vector3.new(1286 - curPos.X, 407 - curPos.Y, 0)
                local upVec = toCenter.Magnitude > 1 and toCenter.Unit or Vector3.new(0, 1, 0)

                local right = forward:Cross(upVec)
                if right.Magnitude > 0.01 then
                    right = right.Unit
                    local trueUp = right:Cross(forward).Unit
                    targetCFrame = CFrame.fromMatrix(curPos, right, trueUp, -forward)
                else
                    targetCFrame = CFrame.lookAt(curPos, curPos + forward)
                end
                
                hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, 0.35)
            else
                targetCFrame = CFrame.lookAt(curPos, curPos + forward)
                hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, 0.28)
            end

            hrp.AssemblyLinearVelocity = forward * dynamicSpeed
            humanoid:Move(forward, false)
        end

        if curDist <= threshold then
            reached = true
            break
        end

        if tick() - startTime > maxDuration then
            break
        end

        RunService.Heartbeat:Wait()
    end

    return isFarming
end

-- Ballistic Jump Controller with Smooth Takeoff Rotation & Index 13 Hop Support
local function executeReliableJump(targetPos, isIndex13)
    if not hrp or not hrp.Parent or not humanoid then return false end

    local g = workspace.Gravity > 0 and workspace.Gravity or 196.2
    local startPos = hrp.Position
    local dx = targetPos.X - startPos.X
    local dz = targetPos.Z - startPos.Z
    local dy = targetPos.Y - startPos.Y
    local horizDist = math.sqrt(dx * dx + dz * dz)
    
    local dirX = horizDist > 0.01 and (dx / horizDist) or 0
    local dirZ = horizDist > 0.01 and (dz / horizDist) or 0
    local moveDir = Vector3.new(dirX, 0, dirZ)

    if horizDist > 0.1 then
        local targetTurn = CFrame.lookAt(startPos, startPos + moveDir)
        hrp.CFrame = hrp.CFrame:Lerp(targetTurn, 0.65)
    end

    local flightTime = math.max(horizDist / BASE_SPEED, 0.45)
    
    local vy
    if isIndex13 then
        vy = math.clamp((dy + 0.5 * g * flightTime * flightTime) / flightTime, 65, 95) + math.random(-1, 1)
    else
        vy = math.clamp((dy + 0.5 * g * flightTime * flightTime) / flightTime, 60, 140) + math.random(-1, 1)
    end

    if runTrack and runTrack.IsPlaying then runTrack:Stop(0.1) end
    if jumpTrack then jumpTrack:Play(0.1) end

    humanoid:Move(moveDir, false)
    humanoid.Jump = true
    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

    hrp.AssemblyLinearVelocity = Vector3.new(dirX * BASE_SPEED, vy, dirZ * BASE_SPEED)

    local startTick = tick()
    local landed = false

    while isFarming and not landed do
        local curPos = hrp.Position
        local curFlatDist = math.sqrt((targetPos.X - curPos.X)^2 + (targetPos.Z - curPos.Z)^2)
        local curYDiff = math.abs(targetPos.Y - curPos.Y)
        local currentYVel = hrp.AssemblyLinearVelocity.Y

        if curFlatDist > 1.2 then
            local curDirX = (targetPos.X - curPos.X) / curFlatDist
            local curDirZ = (targetPos.Z - curPos.Z) / curFlatDist
            hrp.AssemblyLinearVelocity = Vector3.new(curDirX * BASE_SPEED, currentYVel, curDirZ * BASE_SPEED)
        end

        if (curFlatDist <= 4.5 and curYDiff <= 5.5 and (currentYVel <= 2 or humanoid.FloorMaterial ~= Enum.Material.Air)) or (tick() - startTick > flightTime + 0.35) then
            landed = true
            break
        end

        RunService.Heartbeat:Wait()
    end

    if jumpTrack then jumpTrack:Stop(0.15) end
    if runTrack and not runTrack.IsPlaying then
        runTrack:Play(0.15)
        runTrack:AdjustSpeed(1.45)
    end

    return isFarming
end

-- Precision Short Touchdown onto TP Pad (37 -> 38)
local function executeTouchdownStep(targetPos)
    if not hrp or not hrp.Parent or not humanoid then return false end

    local startTime = tick()
    while isFarming and (tick() - startTime < 0.6) do
        local curPos = hrp.Position
        local delta = targetPos - curPos
        local dist = delta.Magnitude

        if dist > 0.1 then
            local dir = delta / dist
            local targetRot = CFrame.lookAt(curPos, curPos + Vector3.new(dir.X, 0, dir.Z))
            hrp.CFrame = hrp.CFrame:Lerp(targetRot, 0.3)
            hrp.AssemblyLinearVelocity = dir * 120
            humanoid:Move(dir, false)
        end

        if dist <= 3.0 then break end
        RunService.Heartbeat:Wait()
    end

    hrp.AssemblyLinearVelocity = Vector3.zero
    humanoid:Move(Vector3.zero, false)
    return isFarming
end

-- ====================================================================
--                         MAIN AUTO-FARM CYCLE
-- ====================================================================

local function runFarmCycle()
    syncCharacter()
    if not hrp or not humanoid or humanoid.Health <= 0 then
        forceReset()
        return
    end

    -- If stopped far from spawn, reset character cleanly
    if (hrp.Position - spawnPos).Magnitude > 35 then
        forceReset()
    end

    -- Minimal 0.1s tick to ensure server registers start line
    if runTrack then runTrack:Stop() end
    humanoid:Move(Vector3.zero, false)
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.1)

    -- Sprints directly from Waypoint 2 to 36 (Skips point 1 spawn shuffle)
    for i = 2, 36 do
        if not isFarming then return end
        
        local wp = coordinates[i]
        local targetPos = Vector3.new(wp.x, wp.y, wp.z)
        local isSpiral = (wp.index >= 17 and wp.index <= 35)
        local isIndex13 = (wp.index == 13)

        if wp.type == "Jump" then
            executeReliableJump(targetPos, isIndex13)
        else
            executeHumanWalk(targetPos, isSpiral)
        end

        -- Safe Stop: Touches down safely on nearest flat walk point outside spiral before halting
        if stopRequested and wp.type == "Walk" and not isSpiral then
            completeHardStop()
            return
        end
    end

    -- ================================================================
    -- FINISH APPROACH (37) & TP PAD DROP (38) WITH 6 RETRIES
    -- ================================================================
    local pt37 = Vector3.new(coordinates[37].x, coordinates[37].y, coordinates[37].z)
    local pt38 = Vector3.new(coordinates[38].x, coordinates[38].y, coordinates[38].z)

    if isFarming then
        executeReliableJump(pt37, false)
    end

    if stopRequested then
        completeHardStop()
        return
    end

    local tpSucceeded = false

    for attempt = 1, MAX_TP_ATTEMPTS do
        if not isFarming then return end

        executeTouchdownStep(pt38)

        if runTrack then runTrack:Stop() end
        hrp.AssemblyLinearVelocity = Vector3.zero
        humanoid:Move(Vector3.zero, false)
        fireWinTrigger()

        -- Fast TP check (checks continuously without extra idle padding)
        local waitStart = tick()
        while isFarming and (tick() - waitStart < 1.0) do
            task.wait(0.08)
            if not hrp or not hrp.Parent then break end

            local distToSpawn = (hrp.Position - spawnPos).Magnitude
            local distFromEnd = (hrp.Position - pt38).Magnitude

            if distToSpawn <= 220 or distFromEnd >= 300 then
                tpSucceeded = true
                break
            end
        end

        if tpSucceeded then break end

        -- Step back to 37 and drop again if needed
        executeTouchdownStep(pt37)
        task.wait(0.1)
    end

    -- Zero useless delays on loop restart
    if tpSucceeded then
        task.wait(0.1)
    else
        forceReset()
    end
end

-- ====================================================================
--                         EVENT HANDLERS
-- ====================================================================

local function startFarm()
    if isFarming then return end
    isFarming = true
    stopRequested = false
    startBtn.Text = "STOP FARM"
    sbGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 80)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 30, 40))
    })

    task.spawn(function()
        while isFarming do
            runFarmCycle()
            task.wait(0.02)
        end
        completeHardStop()
    end)
end

startBtn.MouseButton1Click:Connect(function()
    if isFarming then
        if stopRequested then
            -- Force immediate emergency stop if clicked twice
            completeHardStop()
        else
            stopRequested = true
            startBtn.Text = "STOPPING (SAFE LANDING)..."
            sbGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 140, 0)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 80, 0))
            })
        end
    else
        startFarm()
    end
end)

player.CharacterAdded:Connect(function(newChar)
