local function setupCharacterAnimations()
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    if runTrack then pcall(function() runTrack:Stop(0.1) end) end
    if jumpTrack then pcall(function() jumpTrack:Stop(0.1) end) end

    local runId = (humanoid.RigType == Enum.HumanoidRigType.R6) and "rbxassetid://180426354" or "rbxassetid://507767714"
    local jumpId = (humanoid.RigType == Enum.HumanoidRigType.R6) and "rbxassetid://125750702" or "rbxassetid://507765000"

    local animScript = character:FindFirstChild("Animate")
    if animScript then
        pcall(function()
            if animScript:FindFirstChild("run") and animScript.run:FindFirstChild("RunAnim") then
                runId = animScript.run.RunAnim.AnimationId
            elseif animScript:FindFirstChild("walk") and animScript.walk:FindFirstChild("WalkAnim") then
                runId = animScript.walk.WalkAnim.AnimationId
            end
            if animScript:FindFirstChild("jump") and animScript.jump:FindFirstChild("JumpAnim") then
                jumpId = animScript.jump.JumpAnim.AnimationId
            end
        end)
    end

    local runAnim = Instance.new("Animation")
    runAnim.AnimationId = runId
    runTrack = animator:LoadAnimation(runAnim)
    runTrack.Priority = Enum.AnimationPriority.Movement
    runTrack.Looped = true

    local jumpAnim = Instance.new("Animation")
    jumpAnim.AnimationId = jumpId
    jumpTrack = animator:LoadAnimation(jumpAnim)
    jumpTrack.Priority = Enum.AnimationPriority.Action
    jumpTrack.Looped = false
end

