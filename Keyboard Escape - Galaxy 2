local function syncCharacter()
    character = player.Character or player.CharacterAdded:Wait()
    hrp = character:WaitForChild("HumanoidRootPart", 5)
    humanoid = character:WaitForChild("Humanoid", 5)
    if humanoid then
        humanoid.WalkSpeed = BASE_SPEED
        humanoid.AutoRotate = true
    end
end

local function forceReset()
    if humanoid then humanoid.Health = 0 end
    player.CharacterAdded:Wait()
    task.wait(1.2)
    syncCharacter()
end

local function fireWinTrigger()
    if not hrp then return end
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and (part.Position - hrp.Position).Magnitude <= 25 then
            if typeof(firetouchinterest) == "function" then
                pcall(function()
                    firetouchinterest(hrp, part, 0)
                    task.wait(0.02)
                    firetouchinterest(hrp, part, 1)
                end)
            end
        end
    end
end

local function executeReliableJump(targetPos)
    if not hrp or not hrp.Parent or not humanoid then return false end

    local g = workspace.Gravity > 0 and workspace.Gravity or 196.2
    local startPos = hrp.Position
    local dx = targetPos.X - startPos.X
    local dz = targetPos.Z - startPos.Z
    local dy = targetPos.Y - startPos.Y
    local horizDist = math.sqrt(dx * dx + dz * dz)
    
    local dirX = horizDist > 0.01 and (dx / horizDist) or 0
    local dirZ = horizDist > 0.01 and (dz / horizDist) or 0

    local vy, flightTime

    if dy > 3 then
        local extraApex = 5.0
        local totalRise = dy + extraApex
        vy = math.sqrt(2 * g * totalRise)
        local tRise = vy / g
        local tFall = math.sqrt(2 * extraApex / g)
        flightTime = tRise + tFall
    else
        local baseJumpPower = 60
        vy = baseJumpPower
        local discriminant = (vy * vy) - (2 * g * dy)
        if discriminant > 0 then
            flightTime = (vy + math.sqrt(discriminant)) / g
        else
            flightTime = (2 * vy) / g
        end
    end

    local requiredHorizSpeed = math.clamp(horizDist / math.max(flightTime, 0.1), 35, BASE_SPEED)

    humanoid:Move(Vector3.new(dirX, 0, dirZ), false)
    humanoid.Jump = true
    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

    hrp.AssemblyLinearVelocity = Vector3.new(dirX * requiredHorizSpeed, vy, dirZ * requiredHorizSpeed)

    local startTick = tick()
    local landed = false

    while isFarming and not landed do
        local curPos = hrp.Position
        local curFlatDist = math.sqrt((targetPos.X - curPos.X)^2 + (targetPos.Z - curPos.Z)^2)
        local curYDiff = math.abs(targetPos.Y - curPos.Y)
        local currentYVel = hrp.AssemblyLinearVelocity.Y

        if curFlatDist > 1.2 then
            local curDirX = (targetPos.X - curPos.X) / curFlatDist
            local curDirZ = (targetPos.Z - curPos.Z) / curFlatDist
            hrp.AssemblyLinearVelocity = Vector3.new(curDirX * requiredHorizSpeed, currentYVel, curDirZ * requiredHorizSpeed)
        end

        if (curFlatDist <= 4.5 and curYDiff <= 5.5 and (currentYVel <= 2 or humanoid.FloorMaterial ~= Enum.Material.Air)) or (tick() - startTick > flightTime + 0.4) then
            landed = true
            break
        end

        RunService.Heartbeat:Wait()
    end

    return isFarming
end

local function executeHumanWalk(targetPos, nextWp)
    if not hrp or not hrp.Parent or not humanoid then return false end

    local dynamicSpeed = BASE_SPEED + math.random(-4, 2)
    local nextPos = nextWp and Vector3.new(nextWp.x, nextWp.y, nextWp.z) or nil

    if nextPos and nextWp.type == "Walk" then
        local toCur = (targetPos - hrp.Position).Unit
        local toNext = (nextPos - targetPos).Unit
        local dot = toCur:Dot(toNext)
        if dot < 0.65 then
            dynamicSpeed = 120
        end
    end

    humanoid.WalkSpeed = dynamicSpeed

    local reached = false
    local startTime = tick()

    while isFarming and not reached do
        local curPos = hrp.Position
        local deltaX = targetPos.X - curPos.X
        local deltaZ = targetPos.Z - curPos.Z
        local horizontalDist = math.sqrt(deltaX * deltaX + deltaZ * deltaZ)
        local verticalDist = math.abs(targetPos.Y - curPos.Y)

        humanoid:MoveTo(targetPos)

        if horizontalDist > 0.5 then
            local dirX = deltaX / horizontalDist
            local dirZ = deltaZ / horizontalDist
            local currentYVel = hrp.AssemblyLinearVelocity.Y
            hrp.AssemblyLinearVelocity = Vector3.new(dirX * dynamicSpeed, currentYVel, dirZ * dynamicSpeed)
        end

        if horizontalDist <= 4.0 and verticalDist <= 5.0 then
            reached = true
            break
        end

        if tick() - startTime > 3.2 then
            humanoid.Jump = true
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            break
        end

        RunService.Heartbeat:Wait()
    end

    if nextWp and nextWp.type == "Walk" and math.random(1, 10) == 1 then
        task.wait(math.random(5, 10) / 100)
    end

    return isFarming
end

-- ====================================================================
--                         MAIN AUTO-FARM CYCLE
-- ====================================================================

local function runFarmCycle()
    syncCharacter()
    if not hrp or not humanoid or humanoid.Health <= 0 then
        forceReset()
        return
    end

    -- Settle at spawn to initialize Stage 1 session
    humanoid:Move(Vector3.zero, false)
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.5)

    -- Waypoints 1 to 43 (Smooth Path Execution)
    for i = 1, 43 do
        if not isFarming then return end
        
        local wp = coordinates[i]
        local nextWp = coordinates[i + 1]
        local targetPos = Vector3.new(wp.x, wp.y, wp.z)

        if wp.type == "Jump" then
            executeReliableJump(targetPos)
        else
            executeHumanWalk(targetPos, nextWp)
        end
    end

    -- ================================================================
    -- WAYPOINT 44: DROP ONTO TP PAD & 1s STATIONARY WAIT (6 RETRIES)
    -- ================================================================
    local pt43 = Vector3.new(coordinates[43].x, coordinates[43].y, coordinates[43].z)
    local pt44 = Vector3.new(coordinates[44].x, coordinates[44].y, coordinates[44].z)
    local tpSucceeded = false

    for attempt = 1, MAX_TP_ATTEMPTS do
        if not isFarming then return end

        executeReliableJump(pt44)
        
        hrp.AssemblyLinearVelocity = Vector3.zero
        humanoid:Move(Vector3.zero, false)
        fireWinTrigger()

        local waitStart = tick()
        while isFarming and (tick() - waitStart < 1.0) do
            task.wait(0.08)
            if not hrp or not hrp.Parent then break end

            local distToSpawn = (hrp.Position - spawnPos).Magnitude
            local distFromEnd = (hrp.Position - pt44).Magnitude

            if distToSpawn <= 220 or distFromEnd >= 300 then
                tpSucceeded = true
                break
            end
        end

        if tpSucceeded then break end

        executeHumanWalk(pt43, coordinates[44])
        task.wait(0.1)
    end

    if tpSucceeded then
        task.wait(0.5)
    else
        forceReset()
    end
end

-- ====================================================================
--                         EVENT HANDLERS
-- ====================================================================

local function startFarm()
    if isFarming then return end
    isFarming = true
    startBtn.Text = "STOP FARM"
    sbGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 80)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 30, 40))
    })

    task.spawn(function()
        while isFarming do
            runFarmCycle()
            task.wait(0.05)
        end
    end)
end

local function stopFarm()
    isFarming = false
    startBtn.Text = "START FARM"
    sbGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 225, 140)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 160, 220))
    })
    if humanoid then
        humanoid:Move(Vector3.zero, false)
    end
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
end

startBtn.MouseButton1Click:Connect(function()
    if isFarming then stopFarm() else startFarm() end
end)

player.CharacterAdded:Connect(function(newChar)
    character = newChar
    hrp = newChar:WaitForChild("HumanoidRootPart", 5)
    humanoid = newChar:WaitForChild("Humanoid", 5)
    if isFarming then
        task.wait(0.5)
        syncCharacter()
    end
end)
